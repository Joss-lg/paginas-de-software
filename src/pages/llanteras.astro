---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeaderLlantera from '../components/llantera/HeaderLlantera.astro';
import BannerLlantera from '../components/llantera/BannerLlantera.astro';
import CaracteristicasLlantera from '../components/llantera/CaracteristicasLlantera.astro';
import ModulosOperativosLlantera from '../components/llantera/ModulosOperativosLlantera.astro';
import AccesoDispositivosLlantera from '../components/llantera/AccesoDispositivosLlantera.astro';
import PlanesPrecioLlantera from '../components/llantera/PlanesPrecioLlantera.astro';
import DemoLlantera from '../components/llantera/DemoLlantera.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sistema Llantero Enterprise | Operaciones y Multisucursal">
    <Navbar />
      <!-- Enlace estructural preparado para la vista común (sin interactuar con el navbar/sidebar) -->
  <div id="vista-comun-enlace" data-common-view-route="/comun/catalogo-sistemas" class="hidden"></div>

  <main class="w-full flex flex-col">
    <HeaderLlantera />
   <!-- Banner temático de llantera insertado -->
    <BannerLlantera 
        image="/public/llantera/banner-llantas-uno.webp" 
        alt="Neumáticos de alto rendimiento en pista de prueba"
    >
        "Potencia tu negocio automotriz con un <span class="text-blue-400 underline decoration-blue-500">sistema</span>  de gestión ideal para emprendedores."
    </BannerLlantera> 
    <CaracteristicasLlantera />
    <BannerLlantera 
        image="/public/llantera/banner-llantas-dos.webp" 
        alt="Neumáticos de alto rendimiento en pista de prueba"
    >
        " Acelera las ventas de tu taller con nuestra  <span class="text-blue-400 underline decoration-blue-500">plataforma digital</span> especializada."
    </BannerLlantera>
    <ModulosOperativosLlantera />

<!-- Nuevo componente insertado aquí -->
    <AccesoDispositivosLlantera />

    <PlanesPrecioLlantera />
    <DemoLlantera />
    <Footer />
  </main>
</Layout>