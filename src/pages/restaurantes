---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroRestaurante from '../components/restaurantes/HeroRestaurante.astro';
import CaracteristicasRestaurante from '../components/restaurantes/CaracteristicasRestaurante.astro';
import ModulosRestaurante from '../components/restaurantes/ModulosRestaurante.astro';
import EcosistemaRestaurante from '../components/restaurantes/EcosistemaRestaurante.astro';
---

<Layout title="Software Punto de Venta para Restaurantes | Ollintem">
  <Navbar />
  
  <main class="pt-16 bg-white">
    <HeroRestaurante />
    <CaracteristicasRestaurante />
    <ModulosRestaurante />
    <EcosistemaRestaurante />
    
    <!-- CTA Final -->
    <section class="bg-gray-50 py-24 border-t border-gray-200">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-4xl font-extrabold text-gray-900 mb-6">
          Optimiza el servicio de tu restaurante de principio a fin<span class="text-orange-600">.</span>
        </h2>
        <p class="text-xl text-gray-600 mb-10">
          Control total de mesas, comandas y caja en una sola plataforma.
        </p>
        <a href="/#planes" class="inline-block bg-orange-600 text-white font-bold text-lg px-10 py-4 rounded hover:bg-orange-700 shadow-lg shadow-orange-500/30 transition-all transform hover:-translate-y-1">
          Contratar hoy mismo
        </a>
      </div>
    </section>
  </main>

  <footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col md:flex-row justify-between items-center">
      <p class="mb-4 md:mb-0">© 2026 Ollintem. Todos los derechos reservados.</p>
      <div class="flex space-x-6">
        <a href="#" class="hover:text-white transition-colors">Soporte</a>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
      </div>
    </div>
  </footer>
</Layout>