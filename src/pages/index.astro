---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SystemCard from '../components/SystemCard.astro';
import Pricing from '../components/Pricing.astro';
---

<Layout title="Ollintem - Sistemas POS y SaaS para Gastronomía">
  <Navbar />
  
  <main>
    <Hero />

    <!-- Sección de Sistemas -->
    <section id="sistemas" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Nuestras Soluciones Gastronómicas</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Sistemas robustos con bases de datos relacionales bien estructuradas[cite: 1]. Diseñados para cubrir las necesidades específicas de tu negocio.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto">
          <SystemCard 
            title="Pizzerías"
            description="Sistema completo para el control total de tu pizzería, desde la toma del pedido hasta la entrega."
            color="bg-orange-500"
            icon="🍕"
            features={[
              "Genera pedidos y registra clientes[cite: 1]",
              "Impresión de tickets automatizada[cite: 1]",
              "Reporte de ventas diario y mensuales[cite: 1]",
              "Manejo seguro por roles y permisos[cite: 1]"
            ]}
          />

          <SystemCard 
            title="Restaurantes"
            description="Agiliza tu servicio de mesas y delivery con un sistema de comandas inteligente y rápido."
            color="bg-blue-600"
            icon="🍽️"
            features={[
              "Levanta comandas fácilmente y agrega productos[cite: 1]",
              "Impresión de tickets en caja y cocina[cite: 1]",
              "Realiza y gestiona pedidos para delivery[cite: 1]",
              "Reporte de ventas diario y mensual detallado[cite: 1]"
            ]}
          />
        </div>
      </div>
    </section>

    <!-- Sección de Funcionamiento (Placeholder para que agregues el contenido visual) -->
    <section id="funcionamiento" class="py-20 bg-gray-50 border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <div class="lg:w-1/2">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">¿Cómo funciona nuestro ecosistema SaaS?</h2>
            <p class="text-gray-600 mb-6 text-lg">Bloqueamos o liberamos módulos según tu nivel de pago para adaptarse exactamente al tamaño de tu operación[cite: 1].</p>
            <ul class="space-y-4">
              <li class="flex items-center gap-3"><div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">1</div> <span class="text-gray-700 font-medium">Implementación inicial rápida.</span></li>
              <li class="flex items-center gap-3"><div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">2</div> <span class="text-gray-700 font-medium">Capacitación continua para tu personal.</span></li>
              <li class="flex items-center gap-3"><div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">3</div> <span class="text-gray-700 font-medium">Operación fluida en la nube.</span></li>
            </ul>
          </div>
          <div class="lg:w-1/2 bg-gray-200 rounded-2xl aspect-video flex items-center justify-center shadow-inner">
            <!-- Aquí puedes colocar una imagen llamativa del dashboard del sistema -->
            <span class="text-gray-400 font-medium">[ Espacio para Mockup del Sistema / Interfaz Visual ]</span>
          </div>
        </div>
      </div>
    </section>

    <Pricing />
  </main>

  <!-- Footer Básico -->
  <footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="mb-4">© 2026 Ollintem. Todos los derechos reservados.</p>
      <div class="flex justify-center space-x-6">
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Contacto</a>
      </div>
    </div>
  </footer>
</Layout>