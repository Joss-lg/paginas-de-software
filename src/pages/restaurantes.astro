---
// src/pages/restaurantes.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroRestaurante from '../components/restaurantes/HeroRestaurante.astro';
import CaracteristicasRestaurante from '../components/restaurantes/CaracteristicasRestaurante.astro';
import EcosistemaRestaurante from '../components/restaurantes/EcosistemaRestaurante.astro';
import ModulosRestaurante from '../components/restaurantes/ModulosRestaurante.astro';
import VideoDemoRestaurante from '../components/restaurantes/VideoDemoRestaurante.astro';
---

<Layout 
  title="Software Punto de Venta para Restaurantes, Pizzerías y Panaderías | Ollintem"
>
  <Navbar />
  
  <main class="pt-16 bg-slate-950 text-slate-100">
    <!-- 1. Propuesta de Valor Primaria -->
    <HeroRestaurante />

    <!-- 2. Beneficios y Funcionalidades Clave -->
    <CaracteristicasRestaurante />

    <!-- 3. Demostración del Ecosistema y Casos de Uso (Panadería, Restaurante, Delivery) -->
    <EcosistemaRestaurante />

    <!-- 4. Oferta Comercial y Precios de Suscripción -->
    <ModulosRestaurante />

    <VideoDemoRestaurante/>
    
    <!-- 5. Llamado a la Acción (CTA Final) -->
    <section id="contacto" class="relative bg-gradient-to-b from-slate-900 to-slate-950 py-24 border-t border-slate-800/80">
      <div class="absolute inset-0 bg-orange-600/5 blur-3xl pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
        <span class="inline-block px-3 py-1 mb-4 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/20 text-xs font-bold uppercase tracking-widest">
          Despliegue Inmediato
        </span>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6">
          Optimiza el servicio de tu restaurante de principio a fin<span class="text-orange-500">.</span>
        </h2>

        <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto font-normal leading-relaxed">
          Control total de mesas, comandas, entregas a domicilio y caja registradora en una sola plataforma SaaS.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#planes" 
            class="w-full sm:w-auto inline-flex justify-center items-center bg-orange-600 hover:bg-orange-500 text-white font-bold text-lg px-10 py-4 rounded-xl shadow-lg shadow-orange-600/30 transition-all transform hover:-translate-y-0.5"
          >
            Contratar Plan Hoy Mismo
          </a>
          <a 
            href="https://wa.me/#" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex justify-center items-center bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-lg px-8 py-4 rounded-xl border border-slate-700 transition-all"
          >
            Hablar con un Asesor
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Pie de página -->
  <footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800/60 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-center md:text-left">
        <p class="font-bold text-slate-200">Ollintem Software SaaS</p>
        <p class="text-xs text-slate-500 mt-1">© 2026 Ollintem. Todos los derechos reservados.</p>
      </div>

      <div class="flex flex-wrap justify-center space-x-6 text-xs font-medium">
        <a href="#" class="hover:text-orange-400 transition-colors">Soporte Técnico</a>
        <a href="#" class="hover:text-orange-400 transition-colors">Términos de Servicio</a>
        <a href="#" class="hover:text-orange-400 transition-colors">Política de Privacidad</a>
      </div>
    </div>
  </footer>
</Layout>