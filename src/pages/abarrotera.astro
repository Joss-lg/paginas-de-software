---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AbarroteraHero from '../components/abarrotera/AbarroteraHero.astro';
import BannerAbarrotes from '../components/abarrotera/BannerAbarrotes.astro';
import AbarroteraFeatures from '../components/abarrotera/AbarroteraFeatures.astro';
import AbarroteraPricing from '../components/abarrotera/AbarroteraPricing.astro';
import AbarroteraVideo from '../components/abarrotera/AbarroteraVideo.astro';
import AbarroteraServices from '../components/abarrotera/AbarroteraServices.astro';

---

<Layout title="Sistema para Abarroteras | Ollintem">
    <Navbar />
  <main>
    <!-- Hero Section -->
    <AbarroteraHero />

    <BannerAbarrotes 
    image="/public/abarrotera/banner-abarrotes-uno.webp" 
    alt="Alumnos comprando en la cooperativa escolar"
    customClass="-mt-12" 
>
    "<span class="text-[#FF8A95] underline decoration-[#FF8A95]">Sistema</span> de inventarios para optimizar tu comercio local."
</BannerAbarrotes>

    <!-- Features Bento Grid -->
    <AbarroteraFeatures />

    <!-- Video Demo Section -->
    <AbarroteraVideo />

    <!-- Dispositivos Compatibles -->
    <AbarroteraServices />

    <BannerAbarrotes 
    image="/public/abarrotera/banner-abarrotes-dos.webp" 
    alt="Alumnos comprando en la cooperativa escolar"
    customClass="-mt-12" 
>
    "Punto de venta <span class="text-[#FF8A95] underline decoration-[#FF8A95]">digital</span> para modernizar tu abarrotera."
</BannerAbarrotes>

    <!-- Pricing Section -->
    <AbarroteraPricing />

    <Footer />

  </main>
</Layout>