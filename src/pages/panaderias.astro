---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroPanaderia from '../components/panaderia/HeroPanaderia.astro';
import BannerPanaderia from '../components/panaderia/BannerPanaderia.astro';
import Caracteristicas from '../components/panaderia/Caracteristicas.astro';
import ModulosOperativos from '../components/panaderia/ModulosOperativos.astro';
import PlanesPrecios from '../components/panaderia/PlanesPrecios.astro';
import DemoSeccion from '../components/panaderia/DemoSeccion.astro';
import Footer from '../components/Footer.astro';

---

<Layout title="Software Punto de Venta para Panaderías | Sistema POS">
  <Navbar />
  <!-- Enlace estructural preparado para la vista común (sin interactuar con el navbar/sidebar) -->
  <div id="vista-comun-enlace" data-common-view-route="/comun/catalogo-sistemas" class="hidden"></div>

  <main class="overflow-hidden bg-white">
    <HeroPanaderia />
    <!-- 1. Primer Banner (El de tu captura) -->
<BannerPanaderia 
    image="/public/panaderia/banner-uno-pan.webp" 
    alt="Variedad de panes artesanales"
    customClass="-mt-12" 
>
    " <span class="text-[#f4d4a4] underline decoration-[#c48b47]">Automatiza</span> tu producción con un sistema inteligente para tu negocio."
</BannerPanaderia>
    <Caracteristicas />
    <!-- 3. SEGUNDO BANNER (NUEVO DESCANSO VISUAL) -->
<!-- Aquí no le ponemos el -mt-12 para que fluya normal entre las secciones -->
<BannerPanaderia 
    image="/public/panaderia/banner-dos-pan.webp" 
    alt="Pan dulce tradicional recién horneado"
>
    "<span class="text-[#f4d4a4] underline decoration-[#c48b47]">Tecnología</span> y control de inventarios para modernizar tu panadería"
</BannerPanaderia>
    <ModulosOperativos />
    <DemoSeccion />
    <PlanesPrecios />
    <Footer />
  </main>

</Layout>
