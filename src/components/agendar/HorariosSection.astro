---
// src/components/agendar/HorariosSection.astro
---

<div class="bg-slate-900/90 p-6 md:p-8 flex flex-col justify-between text-slate-200">
  <div class="space-y-6">
    <!-- Bloque: Duración de la reunión -->
    <div>
      <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-2">
        Duración de la reunión
      </h3>
      <div class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl py-3 px-4 text-center text-slate-200 font-medium text-sm flex items-center justify-center gap-2 shadow-inner">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>1 hora</span>
      </div>
    </div>

    <!-- Bloque: Fecha seleccionada y zona horaria -->
    <div class="space-y-2">
      <h3 class="text-lg font-bold text-slate-100">
        ¿A qué hora puedes? <span class="text-emerald-400">*</span>
      </h3>
      <p class="text-sm text-slate-400">
        Mostrando los horarios para: <span id="selected-date-text" class="font-bold text-emerald-400">Seleccione un día</span>
      </p>

      <!-- Selector de Zona Horaria -->
      <div class="relative pt-2">
        <select class="w-full bg-slate-800/60 border border-slate-700 text-emerald-400 text-xs font-semibold rounded-lg px-3 py-2 pr-8 appearance-none focus:outline-none focus:border-emerald-400 transition cursor-pointer">
          <option>UTC -06:00 Hora estándar del centro</option>
          <option>UTC -05:00 Hora del Este</option>
          <option>UTC -07:00 Hora de la montaña</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 pt-2 text-emerald-400">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
        </div>
      </div>
    </div>

    <!-- Lista de Horarios Disponibles (Intervalos de 1 hora de 10:00 AM a 6:00 PM) -->
    <div class="space-y-2.5 max-h-[290px] overflow-y-auto pr-1 text-sm scrollbar-thin scrollbar-thumb-slate-700" id="time-slots-container">
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>10:00 AM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>11:00 AM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>12:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>1:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>2:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>3:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>4:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>5:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>6:00 PM</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
    </div>
  </div>

  <!-- Contenedor Inferior: Mensaje Prediseñado y Enlace API WhatsApp -->
  <div class="pt-4 border-t border-slate-800 mt-6 space-y-3">
    <div id="preview-message-box" class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 text-xs text-slate-300 transition duration-300">
      <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-400 mb-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <span>Solicitud para el operador</span>
      </div>
      <p id="preview-message-text" class="text-slate-400 italic leading-relaxed">
        Complete todos los datos solicitados para generar el resumen de la cita.
      </p>
    </div>

    <!-- Botón de Confirmación convertido dinámicamente a enlace de WhatsApp con la paleta de colores de la app -->
    <a 
      id="confirm-booking-btn" 
      href="#" 
      target="_blank" 
      rel="noopener noreferrer"
      class="group relative w-full bg-slate-800 text-slate-500 font-bold py-3.5 px-6 rounded-xl shadow-none cursor-not-allowed opacity-50 transition-all duration-300 transform pointer-events-none flex items-center justify-center gap-2 text-center"
    >
      <span>Confirmar Cita por WhatsApp</span>
      <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>
</div>

<script>
  const slotButtons = document.querySelectorAll('.slot-btn');
  const confirmBtn = document.getElementById('confirm-booking-btn') as HTMLAnchorElement;
  const messageBox = document.getElementById('preview-message-box');
  const messageText = document.getElementById('preview-message-text');

  window.addEventListener('agenda-fecha-seleccionada', (e: Event) => {
    const customEvent = e as CustomEvent;
    const dateDisplay = document.getElementById('selected-date-text');
    if (dateDisplay) {
      dateDisplay.textContent = customEvent.detail; 
    }
  });

  slotButtons.forEach(slot => {
    slot.addEventListener('click', () => {
      slotButtons.forEach(s => {
        s.classList.remove('border-emerald-400', 'bg-emerald-500/20', 'ring-2', 'ring-emerald-400/50', 'active-slot');
      });
      slot.classList.add('border-emerald-400', 'bg-emerald-500/20', 'ring-2', 'ring-emerald-400/50', 'active-slot');

      window.dispatchEvent(new CustomEvent('agenda-validar-estado'));
    });
  });

  function verificarRequisitosFormulario() {
    const nombreInput = document.getElementById('nombre-contratista') as HTMLInputElement;
    const productoSelect = document.getElementById('producto-interes') as HTMLSelectElement;
    
    const diaSeleccionado = document.querySelector('.active-day') as HTMLElement;
    const horaSeleccionada = document.querySelector('.active-slot');

    const nombre = nombreInput ? nombreInput.value.trim() : '';
    const productoTexto = productoSelect && productoSelect.selectedIndex > 0 
      ? productoSelect.options[productoSelect.selectedIndex].text 
      : '';
      
    const diaTexto = diaSeleccionado ? diaSeleccionado.dataset.fullDate : '';
    const horaTexto = horaSeleccionada ? horaSeleccionada.querySelector('span')?.textContent?.trim() : '';

    const esValido = Boolean(nombre) && Boolean(productoTexto) && Boolean(diaTexto) && Boolean(horaTexto);

    if (messageText && messageBox) {
      if (esValido) {
        messageText.innerHTML = `Estimado equipo de atención: Se solicita agendar una sesión de atención con la empresa <strong class="text-slate-100 font-semibold">${nombre}</strong> para abordar el tema de <strong class="text-emerald-400 font-semibold">${productoTexto}</strong>, programada para el <strong class="text-slate-100 font-semibold">${diaTexto}</strong> a las <strong class="text-emerald-400 font-semibold">${horaTexto}</strong>.`;
        messageText.classList.remove('italic', 'text-slate-400');
        messageText.classList.add('text-slate-200');
        messageBox.classList.remove('border-slate-800');
        messageBox.classList.add('border-emerald-500/30', 'bg-slate-950/90');
      } else {
        messageText.textContent = 'Complete todos los datos solicitados para generar el resumen de la cita.';
        messageText.classList.add('italic', 'text-slate-400');
        messageText.classList.remove('text-slate-200');
        messageBox.classList.remove('border-emerald-500/30', 'bg-slate-950/90');
        messageBox.classList.add('border-slate-800');
      }
    }

    if (confirmBtn) {
      if (esValido && messageText) {
        // Se construye el mensaje dinámico para enviarlo estructurado a WhatsApp
        const textoMensaje = `Hola, me interesa agendar una demostración de la plataforma. Datos de la cita: Empresa/Contratista: ${nombre} | Servicio: ${productoTexto} | Fecha: ${diaTexto} | Hora: ${horaTexto}`;
        const urlWhatsApp = `https://wa.me/5215651318645?text=${encodeURIComponent(textoMensaje)}`;

        confirmBtn.href = urlWhatsApp;
        confirmBtn.classList.remove('bg-slate-800', 'text-slate-500', 'shadow-none', 'cursor-not-allowed', 'opacity-50', 'pointer-events-none');
        confirmBtn.classList.add(
          'bg-gradient-to-r', 'from-emerald-400', 'to-teal-500', 
          'hover:from-emerald-300', 'hover:to-teal-400', 'text-slate-950', 
          'shadow-lg', 'shadow-emerald-500/25', 'hover:shadow-xl', 
          'hover:shadow-emerald-500/40', 'hover:-translate-y-0.5', 
          'hover:scale-[1.02]', 'active:scale-[0.98]', 'cursor-pointer', 'opacity-100', 'pointer-events-auto'
        );
      } else {
        confirmBtn.href = "#";
        confirmBtn.classList.remove(
          'bg-gradient-to-r', 'from-emerald-400', 'to-teal-500', 
          'hover:from-emerald-300', 'hover:to-teal-400', 'text-slate-950', 
          'shadow-lg', 'shadow-emerald-500/25', 'hover:shadow-xl', 
          'hover:shadow-emerald-500/40', 'hover:-translate-y-0.5', 
          'hover:scale-[1.02]', 'active:scale-[0.98]', 'cursor-pointer', 'opacity-100', 'pointer-events-auto'
        );
        confirmBtn.classList.add('bg-slate-800', 'text-slate-500', 'shadow-none', 'cursor-not-allowed', 'opacity-50', 'pointer-events-none');
      }
    }
  }

  window.addEventListener('agenda-validar-estado', verificarRequisitosFormulario);
</script>