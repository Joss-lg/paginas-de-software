---
// src/components/agendar/HorariosSection.astro
---

<div class="bg-slate-900/90 p-6 md:p-8 flex flex-col justify-between text-slate-200">
  <div class="space-y-6">
    <!-- Bloque: Duración de la reunión -->
    <div>
      <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-2">
        Duración de la reunión
      </h3>
      <div class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl py-3 px-4 text-center text-slate-200 font-medium text-sm flex items-center justify-center gap-2 shadow-inner">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>1 hora</span>
      </div>
    </div>

    <!-- Bloque: Fecha seleccionada y zona horaria -->
    <div class="space-y-2">
      <h3 class="text-lg font-bold text-slate-100">
        ¿de que horario dispone? <span class="text-emerald-400">*</span>
      </h3>
      

      <!-- Selector de Zona Horaria -->
      
    </div>

    <!-- Lista de Horarios Disponibles -->
    <div class="space-y-2.5 max-h-[290px] overflow-y-auto pr-1 text-sm scrollbar-thin scrollbar-thumb-slate-700" id="time-slots-container">
      <button type="button" data-hour="10" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>10:00 AM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="11" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>11:00 AM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="12" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>12:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="13" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>1:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="14" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>2:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="15" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>3:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="16" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>4:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
      <button type="button" data-hour="17" class="slot-btn group w-full bg-slate-800/40 hover:bg-emerald-500/10 border border-slate-700/80 hover:border-emerald-400 text-slate-200 hover:text-emerald-300 font-semibold py-2.5 px-4 rounded-xl transition duration-200 flex items-center justify-between shadow-sm">
        <span>5:00 PM</span>
        <span class="status-badge text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full group-hover:bg-emerald-400 group-hover:text-slate-950 font-bold transition">Disponible</span>
      </button>
    </div>
  </div>

  <!-- Contenedor Inferior: Botón de Confirmación -->
  <div class="pt-4 border-t border-slate-800 mt-6 space-y-3">
    <button 
      id="confirm-booking-btn" 
      type="button" 
      disabled
      class="group relative w-full bg-slate-800 text-slate-500 font-bold py-3.5 px-6 rounded-xl shadow-none cursor-not-allowed opacity-50 transition-all duration-300 transform pointer-events-none flex items-center justify-center gap-2 text-center"
    >
      <span>Confirmar y Registrar Cita</span>
      <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const slotButtons = document.querySelectorAll('.slot-btn');
  const confirmBtn = document.getElementById('confirm-booking-btn') as HTMLButtonElement;

  const mesesES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

  // Transformador de variables: Normaliza cualquier formato de hora (BD o Interfaz) a formato 24h ("HH:MM")
  function normalizarHora(horaStr: string): string {
    if (!horaStr) return '';
    let limpio = horaStr.trim().toLowerCase();
    
    // Si viene en formato MySQL tipo "14:00:00", recortamos a "14:00"
    if (/^\d{2}:\d{2}:\d{2}$/.test(limpio)) {
      return limpio.substring(0, 5);
    }
    if (/^\d{2}:\d{2}$/.test(limpio)) {
      return limpio;
    }

    // Si viene con formato de 12 horas de la interfaz (ej. "02:00 PM", "2:00 p. m.")
    const match12 = limpio.match(/(\d{1,2}):(\d{2})\s*(am|pm|a\. m\.|p\. m\.)/);
    if (match12) {
      let horas = parseInt(match12[1], 10);
      const minutos = match12[2];
      const periodo = match12[3];

      if ((periodo.includes('p') || periodo.includes('P')) && horas < 12) {
        horas += 12;
      }
      if ((periodo.includes('a') || periodo.includes('A')) && horas === 12) {
        horas = 0;
      }
      return `${horas.toString().padStart(2, '0')}:${minutos}`;
    }

    return limpio;
  }

  function esFechaHoy(fechaTexto: string): boolean {
    if (!fechaTexto) return false;
    const ahora = new Date();
    const hoyDia = ahora.getDate();
    const hoyMes = ahora.getMonth();
    const hoyAnio = ahora.getFullYear();

    const textoLower = fechaTexto.toLowerCase().trim();
    const coincidencia = textoLower.match(/(\d{1,2})\s+de\s+([a-z]+)\s+de\s+(\d{4})/);

    if (coincidencia) {
      const dia = parseInt(coincidencia[1], 10);
      const mesNombre = coincidencia[2];
      const anio = parseInt(coincidencia[3], 10);
      const mesIndex = mesesES.indexOf(mesNombre);
      return dia === hoyDia && mesIndex === hoyMes && anio === hoyAnio;
    }

    if (/^\d{4}-\d{2}-\d{2}$/.test(fechaTexto)) {
      const [y, m, d] = fechaTexto.split('-').map(Number);
      return y === hoyAnio && (m - 1) === hoyMes && d === hoyDia;
    }

    return false;
  }

  // Función principal que consulta la BD y aplica el transformador para bloquear horas pasadas + ocupadas
  async function actualizarEstadoHorarios() {
    const diaSeleccionadoElem = document.querySelector('.active-day') as HTMLElement;
    if (!diaSeleccionadoElem) return;

    const fechaTexto = diaSeleccionadoElem.dataset.fullDate || diaSeleccionadoElem.getAttribute('data-full-date') || '';
    const esHoy = esFechaHoy(fechaTexto);

    const ahora = new Date();
    const horaActual = ahora.getHours();

    // 1. Consultar a la base de datos las horas ya apartadas para esta fecha
    let horasOcupadasBD: string[] = [];
    try {
      const esLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const baseURL = esLocal ? 'http://localhost/paginas-de-software/public/api' : '/api'; 
      
      const URL_OBTENER = `${baseURL}/obtener_citas.php?fecha=${encodeURIComponent(fechaTexto)}`;
      const resp = await fetch(URL_OBTENER);
      const data = await resp.json();
      if (data.exito && Array.isArray(data.horasOcupadas)) {
        // Normalizamos todas las horas que vienen de la BD (ej. "14:00:00" -> "14:00")
        horasOcupadasBD = data.horasOcupadas.map((h: string) => normalizarHora(h));
      }
    } catch (err) {
      console.error('Error al consultar disponibilidad en la BD:', err);
    }

    // 2. Evaluar cada botón utilizando el transformador de variables
    slotButtons.forEach(slot => {
      const botonSlot = slot as HTMLButtonElement;
      const horaDataset = botonSlot.dataset.hour || '0'; // Ej: "14"
      const textoHoraSlot = botonSlot.querySelector('span')?.textContent?.trim() || ''; // Ej: "2:00 PM"
      
      const horaNormalizadaBtn = normalizarHora(horaDataset.includes(':') ? horaDataset : `${horaDataset}:00`);
      const horaTextoNormalizada = normalizarHora(textoHoraSlot);

      const horaNumerica = parseInt(horaNormalizadaBtn.split(':')[0], 10);
      const yaPasoHoy = esHoy && horaNumerica <= horaActual;
      
      // Comparamos usando las versiones normalizadas en 24h
      const estaOcupadoBD = horasOcupadasBD.includes(horaNormalizadaBtn) || horasOcupadasBD.includes(horaTextoNormalizada);
      const statusBadge = botonSlot.querySelector('.status-badge');

      if (yaPasoHoy || estaOcupadoBD) {
        botonSlot.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        botonSlot.classList.remove('border-emerald-400', 'bg-emerald-500/20', 'ring-2', 'ring-emerald-400/50', 'active-slot');
        
        if (statusBadge) {
          statusBadge.textContent = 'No disponible';
          statusBadge.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'group-hover:bg-emerald-400');
          statusBadge.classList.add('bg-red-500/20', 'text-red-400');
        }
      } else {
        botonSlot.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        if (statusBadge) {
          statusBadge.textContent = 'Disponible';
          statusBadge.classList.remove('bg-red-500/20', 'text-red-400');
          statusBadge.classList.add('bg-emerald-500/20', 'text-emerald-300', 'group-hover:bg-emerald-400');
        }
      }
    });

    verificarRequisitosFormulario();
  }

  window.addEventListener('agenda-fecha-seleccionada', (e: Event) => {
    const customEvent = e as CustomEvent;
    const dateDisplay = document.getElementById('selected-date-text');
    if (dateDisplay) {
      dateDisplay.textContent = customEvent.detail; 
    }
    actualizarEstadoHorarios();
  });

  slotButtons.forEach(slot => {
    slot.addEventListener('click', () => {
      if (slot.classList.contains('pointer-events-none')) return;

      slotButtons.forEach(s => {
        s.classList.remove('border-emerald-400', 'bg-emerald-500/20', 'ring-2', 'ring-emerald-400/50', 'active-slot');
      });
      slot.classList.add('border-emerald-400', 'bg-emerald-500/20', 'ring-2', 'ring-emerald-400/50', 'active-slot');

      verificarRequisitosFormulario();
    });
  });

  function verificarRequisitosFormulario() {
    const nombreInput = document.getElementById('nombre-contratista') as HTMLInputElement;
    const productoSelect = document.getElementById('producto-interes') as HTMLSelectElement;
    const correoInput = document.getElementById('correo-electronico') as HTMLInputElement;
    const telefonoInput = document.getElementById('telefono-contacto') as HTMLInputElement;
    
    const diaSeleccionado = document.querySelector('.active-day') as HTMLElement;
    const horaSeleccionada = document.querySelector('.active-slot');

    const nombre = nombreInput ? nombreInput.value.trim() : '';
    const productoTexto = productoSelect && productoSelect.selectedIndex > 0 
      ? productoSelect.options[productoSelect.selectedIndex].text 
      : '';
    const correo = correoInput ? correoInput.value.trim() : '';
    const telefono = telefonoInput ? telefonoInput.value.trim() : '';
      
    const diaTexto = diaSeleccionado ? (diaSeleccionado.dataset.fullDate || '') : '';
    const horaTexto = horaSeleccionada ? horaSeleccionada.querySelector('span')?.textContent?.trim() : '';

    const esValido = Boolean(nombre) && Boolean(productoTexto) && Boolean(correo) && Boolean(telefono) && Boolean(diaTexto) && Boolean(horaTexto);

    if (confirmBtn) {
      if (esValido) {
        confirmBtn.removeAttribute('disabled');
        confirmBtn.classList.remove('bg-slate-800', 'text-slate-500', 'shadow-none', 'cursor-not-allowed', 'opacity-50', 'pointer-events-none');
        confirmBtn.classList.add(
          'bg-gradient-to-r', 'from-emerald-400', 'to-teal-500', 
          'hover:from-emerald-300', 'hover:to-teal-400', 'text-slate-950', 
          'shadow-lg', 'shadow-emerald-500/25', 'hover:shadow-xl', 
          'hover:shadow-emerald-500/40', 'hover:-translate-y-0.5', 
          'hover:scale-[1.02]', 'active:scale-[0.98]', 'cursor-pointer', 'opacity-100', 'pointer-events-auto'
        );
      } else {
        confirmBtn.setAttribute('disabled', 'true');
        confirmBtn.classList.remove(
          'bg-gradient-to-r', 'from-emerald-400', 'to-teal-500', 
          'hover:from-emerald-300', 'hover:to-teal-400', 'text-slate-950', 
          'shadow-lg', 'shadow-emerald-500/25', 'hover:shadow-xl', 
          'hover:shadow-emerald-500/40', 'hover:-translate-y-0.5', 
          'hover:scale-[1.02]', 'active:scale-[0.98]', 'cursor-pointer', 'opacity-100', 'pointer-events-auto'
        );
        confirmBtn.classList.add('bg-slate-800', 'text-slate-500', 'shadow-none', 'cursor-not-allowed', 'opacity-50', 'pointer-events-none');
      }
    }
  }

  window.addEventListener('agenda-validar-estado', verificarRequisitosFormulario);

  document.addEventListener('DOMContentLoaded', () => {
    actualizarEstadoHorarios();
  });
  
  setTimeout(actualizarEstadoHorarios, 100);

  confirmBtn?.addEventListener('click', async () => {
    const nombreInput = document.getElementById('nombre-contratista') as HTMLInputElement;
    const productoSelect = document.getElementById('producto-interes') as HTMLSelectElement;
    const correoInput = document.getElementById('correo-electronico') as HTMLInputElement;
    const telefonoInput = document.getElementById('telefono-contacto') as HTMLInputElement;
    const diaSeleccionado = document.querySelector('.active-day') as HTMLElement;
    const horaSeleccionada = document.querySelector('.active-slot');

    const datosCita = {
      nombreContratista: nombreInput.value.trim(),
      productoInteres: productoSelect.options[productoSelect.selectedIndex].text,
      correoElectronico: correoInput.value.trim(),
      telefonoContacto: telefonoInput.value.trim(),
      fechaCita: diaSeleccionado ? diaSeleccionado.dataset.fullDate : '',
      horaCita: horaSeleccionada?.querySelector('span')?.textContent?.trim()
    };

    const esLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const API_URL = esLocal ? 'http://localhost/paginas-de-software/public/api/procesar_cita.php' : '/api/procesar_cita.php';

    try {
      confirmBtn.setAttribute('disabled', 'true');
      confirmBtn.querySelector('span')!.textContent = 'Procesando registro...';

      const respuesta = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json; charset=utf-8'
        },
        body: JSON.stringify(datosCita)
      });

      const resultado = await respuesta.json();

      if (respuesta.ok && resultado.exito) {
        if (typeof (window as any).mostrarModalExito === 'function') {
          (window as any).mostrarModalExito(resultado.mensaje || 'Tu cita ha sido guardada correctamente en el sistema.');
        } else {
          alert('¡Cita registrada con éxito!');
          window.location.reload();
        }
      } else {
        alert('Error: ' + (resultado.mensaje || 'Respuesta no válida del servidor PHP.'));
        confirmBtn.removeAttribute('disabled');
        confirmBtn.querySelector('span')!.textContent = 'Confirmar y Registrar Cita';
      }
    } catch (error) {
      console.error('Error de conexión:', error);
      alert('Error de conexión: Verifica que Apache/XAMPP esté encendido y que la constante API_URL sea correcta.');
      confirmBtn.removeAttribute('disabled');
      confirmBtn.querySelector('span')!.textContent = 'Confirmar y Registrar Cita';
    }
  });
</script>