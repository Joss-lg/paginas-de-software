---
// src/components/agendar/ModalExito.astro
---
<div id="modal-exito" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="bg-slate-900 border border-emerald-500/30 rounded-2xl p-6 md:p-8 max-w-md w-full mx-4 shadow-2xl shadow-emerald-500/10 transform scale-95 transition-transform duration-300" id="modal-content">
    
    <!-- Icono de éxito -->
    <div class="w-12 h-12 bg-emerald-500/20 border border-emerald-500/40 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-400">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <!-- Título y Mensaje -->
    <h3 class="text-xl font-bold text-slate-100 text-center mb-2">
      ¡Cita registrada con éxito!
    </h3>
    <p id="modal-mensaje-texto" class="text-sm text-slate-400 text-center mb-6 leading-relaxed">
      Tu cita ha sido agendada correctamente. En breve recibirás un correo de confirmación con los detalles.
    </p>

    <!-- Botón de acción -->
    <button 
      id="modal-cerrar-btn"
      type="button" 
      class="w-full bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-300 hover:to-teal-400 text-slate-950 font-bold py-3 px-6 rounded-xl shadow-lg shadow-emerald-500/25 transition-all duration-200 cursor-pointer text-center"
    >
      Entendido
    </button>
  </div>
</div>

<script>
  // Funciones globales para abrir y cerrar el modal desde cualquier script de la página
  window.mostrarModalExito = (mensajePersonalizado?: string) => {
    const modal = document.getElementById('modal-exito');
    const contenido = document.getElementById('modal-content');
    const texto = document.getElementById('modal-mensaje-texto');

    if (mensajePersonalizado && texto) {
      texto.textContent = mensajePersonalizado;
    }

    if (modal && contenido) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      contenido.classList.remove('scale-95');
      contenido.classList.add('scale-100');
    }
  };

  function cerrarModalExito() {
    const modal = document.getElementById('modal-exito');
    const contenido = document.getElementById('modal-content');

    if (modal && contenido) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      contenido.classList.remove('scale-100');
      contenido.classList.add('scale-95');
      window.location.reload(); // Recarga la página al cerrar para limpiar estados
    }
  }

  document.getElementById('modal-cerrar-btn')?.addEventListener('click', cerrarModalExito);
</script>