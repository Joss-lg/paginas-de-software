---
---
<section id="planes" class="bg-gray-50 py-24 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl font-extrabold text-gray-900 mb-4">
        Planes diseñados para pizzerías y negocios de mostrador<span class="text-orange-600">.</span>
      </h2>
      <p class="text-xl text-gray-600">
        Elige el nivel de operación ideal según la agilidad y alcance que buscas.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 items-stretch">
      
      <!-- Plan Básico -->
      <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-200 flex flex-col justify-between">
        <div>
          <div class="inline-block bg-orange-100 text-orange-700 font-semibold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-4">
            Básico
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Mostrador / Rápido</h3>
          <p class="text-gray-500 text-sm mb-6">Ideal para pizzerías y panaderías con venta directa de mostrador.</p>
          <div class="text-3xl font-extrabold text-gray-900 mb-6">
            $499 - $599 <span class="text-sm font-normal text-gray-500">/ mes</span>
          </div>
          <ul class="space-y-4 mb-8 text-gray-600 text-sm">
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> 1 caja / estación de cobro.
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Módulo POS, apertura de caja, tickets y alta de categorías/productos.
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Reportes de ventas diarios y mensuales.
            </li>
          </ul>
        </div>
        <a href="#contacto" class="block text-center bg-gray-900 text-white font-bold py-3 rounded-lg hover:bg-gray-800 transition-colors">
          Elegir Básico
        </a>
      </div>

      <!-- Plan Profesional (Destacado / Recomendado) -->
      <div class="bg-white rounded-2xl p-8 shadow-2xl border-2 border-orange-600 flex flex-col justify-between relative transform lg:-translate-y-2">
        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-orange-600 text-white text-xs font-bold uppercase tracking-widest px-4 py-1 rounded-full shadow">
          Ideal para Pizzerías
        </div>
        <div>
          <div class="inline-block bg-orange-100 text-orange-700 font-semibold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-4 mt-2">
            Profesional
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Con Mesas / Operación Media</h3>
          <p class="text-gray-500 text-sm mb-6">Perfecto para negocios que requieren mayor control y estaciones.</p>
          <div class="text-3xl font-extrabold text-orange-600 mb-6">
            $899 - $999 <span class="text-sm font-normal text-gray-500">/ mes</span>
          </div>
          <ul class="space-y-4 mb-8 text-gray-600 text-sm">
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Hasta 3 estaciones (caja + 2 dispositivos para comandas).
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Módulo de roles y permisos activo (cajero, mesero, administrador).
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Gestión de comandas y captura de gastos.
            </li>
          </ul>
        </div>
        <a href="#contacto" class="block text-center bg-orange-600 text-white font-bold py-3 rounded-lg hover:bg-orange-700 shadow-md transition-colors">
          Contratar Profesional
        </a>
      </div>

      <!-- Plan Premium (Con Delivery) -->
      <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-200 flex flex-col justify-between">
        <div>
          <div class="inline-block bg-orange-100 text-orange-700 font-semibold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-4">
            Premium
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Con Delivery</h3>
          <p class="text-gray-500 text-sm mb-6">Para pizzerías con fuerte enfoque en entrega a domicilio.</p>
          <div class="text-3xl font-extrabold text-gray-900 mb-6">
            $1,299 <span class="text-sm font-normal text-gray-500">/ mes</span>
          </div>
          <ul class="space-y-4 mb-8 text-gray-600 text-sm">
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Estaciones ilimitadas.
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Módulo de pedidos para delivery.
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 font-bold mr-2">✓</span> Integración y registro avanzado de clientes.
            </li>
          </ul>
        </div>
        <a href="#contacto" class="block text-center bg-gray-900 text-white font-bold py-3 rounded-lg hover:bg-gray-800 transition-colors">
          Elegir Premium
        </a>
      </div>

    </div>
  </div>
</section>