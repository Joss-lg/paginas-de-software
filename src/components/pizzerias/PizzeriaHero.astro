---
---
<section class="relative bg-orange-600 pt-24 pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <!-- Texto -->
      <div class="lg:w-1/2 text-white">
        <p class="text-orange-200 font-semibold tracking-wide uppercase mb-3">Software especializado</p>
        <h1 class="text-5xl md:text-6xl font-extrabold mb-6 leading-tight">
          El mejor sistema punto de venta para <span class="text-orange-200">pizzerías.</span>
        </h1>
        <p class="text-xl text-orange-50 mb-8 max-w-lg">
          Genera pedidos, registra clientes, imprime tickets y genera reporte de ventas diario y mensuales[cite: 1].
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demo" class="bg-white text-orange-600 font-bold px-8 py-3 rounded hover:bg-gray-100 transition-colors shadow-lg text-center flex items-center justify-center gap-2">
            Descargar demo para pizzería 🍕
          </a>
        </div>
      </div>
      
      <!-- Mockup Visual -->
      <div class="lg:w-1/2 relative mt-10 lg:mt-0">
        <!-- Monitor Base -->
        <div class="relative bg-gray-900 rounded-lg p-2 shadow-2xl border-b-8 border-gray-800 transform lg:-rotate-2 hover:rotate-0 transition-transform duration-500 z-20">
          <div class="bg-white rounded aspect-[16/9] flex items-center justify-center overflow-hidden relative">
            <div class="absolute inset-0 bg-gray-100 flex flex-col items-center justify-center">
              <span class="text-4xl font-black text-orange-600 tracking-tighter">Ollintem<span class="text-gray-900">.</span></span>
              <span class="text-xs text-gray-500 font-bold tracking-widest mt-1 uppercase">Software Punto de Venta</span>
            </div>
          </div>
          <!-- Base del monitor -->
          <div class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 w-32 h-4 bg-gray-800"></div>
          <div class="absolute -bottom-8 left-1/2 transform -translate-x-1/2 w-48 h-2 bg-gray-900 rounded-t-sm"></div>
        </div>
      </div>
    </div>
  </div>
</section>