<section class="py-24 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="bg-orange-100 text-orange-700 font-semibold text-xs px-4 py-1.5 rounded-full uppercase tracking-wider">
        Ventas ágiles
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-4">
        Software que acelera tus transacciones<span class="text-orange-600">.</span>
      </h2>
      <p class="text-gray-600 text-lg mt-4">
        Creado para el ritmo de tu pizzería: toma pedidos, registra clientes, emite tickets y analiza tus resultados fácilmente.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 items-stretch">

      <!-- Feature 1: Pedidos y Clientes -->
      <div class="bg-white rounded-3xl p-6 border border-gray-200 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-stone-50 mb-6 shadow-inner aspect-[16/10] flex items-center justify-center">
          <img
            src="/public/pizzeria-pos.webp"
            alt="Módulo de comandas de la plataforma"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center mb-4 shadow-inner">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Pedidos y clientes</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Registra clientes de forma rápida. Visualiza tu menú en instantes para agilizar la atención.
          </p>
        </div>
      </div>

      <!-- Feature 2: Impresión Inmediata -->
      <div class="bg-white rounded-3xl p-6 border border-gray-200 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-stone-50 mb-6 shadow-inner aspect-[16/10] flex items-center justify-center">
          <img
            src="/images/ticket-print.png"
            alt="Generación física de tickets de venta"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center mb-4 shadow-inner">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Emisión de tickets</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            La plataforma imprime el ticket al cobrar, conectando el mostrador con la cocina para evitar errores.
          </p>
        </div>
      </div>

      <!-- Feature 3: Seguridad y Roles -->
      <div class="bg-white rounded-3xl p-6 border border-gray-200 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-stone-50 mb-6 shadow-inner aspect-[16/10] flex items-center justify-center">
          <img
            src="/public/admin-roles.webp"
            alt="Sección de jerarquías y cuentas de usuario"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-4 shadow-inner">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Seguridad y roles</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Gestiona cuentas de usuario: protege tus datos y requiere autorización gerencial de forma general o por acción específica.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>