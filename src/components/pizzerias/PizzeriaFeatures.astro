            alt="Módulo de comandas de la plataforma"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div>
          <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center font-bold mb-4">🍕</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Pedidos y clientes</h3>
