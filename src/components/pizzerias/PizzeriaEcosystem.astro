<section class="py-24 bg-slate-50 overflow-hidden relative">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <div class="absolute -top-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-orange-400/10 blur-[100px]"></div>
    <div class="absolute bottom-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-amber-300/10 blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-100/80 border border-orange-200 backdrop-blur-sm mb-4">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        <span class="text-orange-700 font-bold text-xs tracking-widest uppercase">Herramientas adicionales</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
        Lleva el control más allá del <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-500">mostrador.</span>
      </h2>
      <p class="text-lg text-slate-600">
        Descubre herramientas diseñadas para optimizar la rentabilidad de tu pizzería, gestionar repartos y mantener tus finanzas claras.
      </p>
    </div>

    <!-- Contenedor Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

      <!-- Tarjeta 1: Reportes y caja -->
      <div class="md:col-span-1 group relative bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:border-orange-200 transition-all duration-500 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-br from-orange-100 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="relative z-10 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center mb-6 shadow-inner">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">Reportes y caja</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Obtén reportes de ventas diarios y mensuales. Visualiza entradas, salidas y cortes de caja en tiempo real.
          </p>
        </div>

        <div class="relative z-10 flex-1 flex rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-inner mt-4">
           <img 
            src="/public/caja.webp" 
            alt="Dashboard financiero de la pizzería" 
            class="w-full h-full min-h-[180px] object-cover object-top transform group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>

      <!-- Tarjeta 2: Módulo de Delivery -->
      <div class="md:col-span-1 group relative bg-slate-900 rounded-3xl p-8 border border-slate-800 shadow-lg hover:shadow-2xl hover:border-amber-500/50 transition-all duration-500 overflow-hidden flex flex-col justify-between">
        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-amber-500/20 rounded-full blur-3xl group-hover:bg-amber-500/40 transition-colors duration-500"></div>

        <div class="relative z-10 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 text-amber-400 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Gestión de delivery</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Coordina tus pedidos a domicilio eficazmente. Mantén el control de tus repartidores para asegurar entregas rápidas.
          </p>
        </div>

        <div class="relative z-10 flex-1 flex mt-2 rounded-xl overflow-hidden border border-slate-700 shadow-2xl transform group-hover:scale-105 transition-transform duration-500">
          <img 
            src="/public/modulo-delivery.webp" 
            alt="Módulo de asignación de repartidores" 
            class="w-full h-full min-h-[180px] object-cover object-top opacity-90 group-hover:opacity-100 transition-opacity"
          />
        </div>
      </div>

      <!-- Tarjeta 3: Menú y Gastos Operativos -->
      <div class="md:col-span-1 group relative bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:border-orange-200 transition-all duration-500 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-br from-orange-100 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="relative z-10 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center mb-6 shadow-inner">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">Menú y gastos</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Administra tu menú y registra tus gastos diarios. Mantén tus costos e ingresos siempre bajo control.
          </p>
        </div>

        <div class="relative z-10 flex-1 flex rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-inner mt-4">
           <img 
            src="/public/menu.webp" 
            alt="Gestión de categorías de pizza y registro de gastos" 
            class="w-full h-full min-h-[180px] object-cover object-top transform group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>

      <!-- Tarjeta 4: Gestión de clientes (Ancho completo abajo) -->
      <div class="md:col-span-3 group relative bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:border-orange-200 transition-all duration-500 overflow-hidden flex flex-col md:flex-row items-center gap-8">
        <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-orange-100 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

        <div class="md:w-1/2 relative z-10">
          <div class="w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center mb-6 shadow-inner">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">Gestión de clientes y fidelización</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Registra clientes para ofrecerles un servicio más rápido y cercano. Facilitando el envío de productos a distintos lugares.
          </p>
        </div>

        <div class="md:w-1/2 relative z-10 w-full flex rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-inner">
          <img 
            src="/public/clientes.webp" 
            alt="Gestión de clientes y fidelización" 
            class="w-full h-full min-h-[220px] md:min-h-[260px] object-cover object-top transform group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>

    </div>
  </div>
</section>