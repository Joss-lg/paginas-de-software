<section class="py-24 bg-orange-50/60 overflow-hidden border-y border-orange-100 relative">
  <!-- Glow de fondo decorativo -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-orange-400/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-400/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">

      <!-- Columna Izquierda: Pasos detallados -->
      <div class="lg:w-1/2 w-full">
        <div class="space-y-8">
          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-orange-600 text-white flex items-center justify-center font-extrabold text-xl shadow-lg shadow-orange-900/20 group-hover:scale-110 transition-transform duration-300">1</div>
            <div>
              <h4 class="text-xl font-bold text-gray-900 mb-2">Configura tu menú</h4>
              <p class="text-gray-600 leading-relaxed">Registra tus categorías (pizzas, bebidas, complementos) y personaliza ingredientes. Tu sistema estará listo en minutos.</p>
            </div>
          </div>

          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-orange-600 text-white flex items-center justify-center font-extrabold text-xl shadow-lg shadow-orange-900/20 group-hover:scale-110 transition-transform duration-300">2</div>
            <div>
              <h4 class="text-xl font-bold text-gray-900 mb-2">Toma el pedido</h4>
              <p class="text-gray-600 leading-relaxed">En el módulo de ventas, selecciona los productos, ingresa los detalles del cliente y envía la orden a cocina al instante.</p>
            </div>
          </div>

          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-orange-600 text-white flex items-center justify-center font-extrabold text-xl shadow-lg shadow-orange-900/20 group-hover:scale-110 transition-transform duration-300">3</div>
            <div>
              <h4 class="text-xl font-bold text-gray-900 mb-2">Procesa el pago</h4>
              <p class="text-gray-600 leading-relaxed">Finaliza la venta, registra la forma de pago y el sistema emitirá el ticket de forma automática.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Texto y Mockups Animados -->
      <div class="lg:w-1/2 w-full">
        <span class="bg-white text-orange-700 font-semibold text-xs px-4 py-1.5 rounded-full uppercase tracking-wider border border-orange-200 shadow-sm inline-block mb-4">
          Proceso de venta
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 tracking-tight">¿Cómo funciona el sistema en el día a día?</h2>
        <p class="text-lg text-gray-600 mb-8 leading-relaxed">
          Diseñado para eliminar cuellos de botella. El proceso es directo: levanta el pedido, cobra y entrega, todo desde un punto de venta ágil y visual.
        </p>

        <!-- Contenedor Visual con Animaciones y Mockups -->
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Tarjeta principal simulando el dashboard de pedidos -->
          <div class="bg-white rounded-3xl shadow-xl shadow-orange-950/10 border border-orange-100 p-6 relative z-20 transition-transform duration-500 hover:scale-[1.01]">
            <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              </div>
              <span class="text-xs font-bold text-orange-600 bg-orange-50 px-3 py-1 rounded-full animate-pulse">Orden activa #104</span>
            </div>
            
            <!-- Imagen simulada o mockup con efecto hover y zoom -->
            <div class="rounded-2xl overflow-hidden aspect-[16/9] bg-stone-900 relative shadow-inner group">
              <img
                src="/public/interfaz-pizzeria.webp"
                alt="Interfaz del sistema de pedidos para pizzería"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
