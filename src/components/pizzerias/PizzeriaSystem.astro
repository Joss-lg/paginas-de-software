              <!-- Capa de luz sutil -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60"></div>
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white text-xs font-medium">
                <span>🍕 Pizza Pepperoni Familiar</span>
                <span class="bg-orange-600 px-2 py-0.5 rounded text-white font-bold">$210.00</span>
              </div>
            </div>
          </div>

          <!-- Tarjeta flotante secundaria con animación -->
          <div class="absolute -bottom-6 -left-6 bg-white shadow-lg border border-orange-100 rounded-2xl p-4 flex items-center gap-3 z-30 animate-bounce motion-reduce:animate-none">
            <span class="text-2xl">🔥</span>
            <div>
              <p class="text-xs font-bold text-gray-900">Enviado a cocina</p>
              <p class="text-[11px] text-gray-500">Impresión de comanda lista</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>