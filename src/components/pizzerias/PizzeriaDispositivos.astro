<section class="py-24 bg-stone-900 overflow-hidden relative">
  <!-- Elementos decorativos animados de fondo -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <div class="absolute top-1/4 left-10 w-72 h-72 rounded-full bg-orange-500/10 blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-amber-500/10 blur-[140px] animate-pulse" style="animation-duration: 4s;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Encabezado con efecto de aparición -->
    <div class="text-center max-w-3xl mx-auto mb-16 transition-all duration-700">
      <span class="inline-block bg-white/10 text-orange-300 border border-white/10 font-semibold text-xs px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm hover:scale-105 transition-transform duration-300">
        Tu pizzería en todas partes
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mt-4 mb-4 tracking-tight">
        Control total, <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-300">desde el mostrador hasta tu móvil</span>
      </h2>
      <p class="text-gray-400 text-base md:text-lg leading-relaxed">
        El sistema se adapta a tu ritmo: velocidad web para ventas en mostrador y versatilidad móvil para supervisar tu negocio desde cualquier sitio.
      </p>
    </div>

    <!-- Contenedor Principal (Web + Mobile) -->
    <div class="grid lg:grid-cols-12 gap-10 items-stretch">

      <!-- Lado Web: POS de Mostrador -->
      <div class="lg:col-span-8 group bg-white p-6 rounded-3xl border border-white/10 shadow-2xl hover:border-orange-500/30 hover:-translate-y-1.5 transition-all duration-500 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6 px-2">
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 bg-red-400 rounded-full group-hover:scale-110 transition-transform"></div>
              <div class="w-3 h-3 bg-amber-400 rounded-full group-hover:scale-110 transition-transform delay-75"></div>
              <div class="w-3 h-3 bg-emerald-400 rounded-full group-hover:scale-110 transition-transform delay-150"></div>
            </div>
            <span class="text-xs font-black text-gray-400 uppercase tracking-widest group-hover:text-orange-600 transition-colors"> Terminal · PC</span>
          </div>

          <div class="rounded-2xl overflow-hidden border border-gray-100 shadow-inner bg-stone-50 aspect-[16/9]">
             <img
              src="/public/modulo-categorias-gastos.webp"
              alt="Interfaz de la plataforma comercial en escritorio"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
          </div>
        </div>

        <div class="mt-6">
          <h3 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors">Eficiencia en mostrador</h3>
          <p class="text-gray-600 text-sm mt-2 leading-relaxed">
            Diseñada para ventas rápidas: captura de pedidos, emisión de tickets y envío inmediato de comandas a cocina.
          </p>
        </div>
      </div>

      <!-- Lado Móvil: Administración y Reportes -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="bg-white group p-6 rounded-3xl border border-white/10 shadow-2xl hover:border-orange-500/30 hover:-translate-y-1.5 transition-all duration-500 h-full flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6 px-2">
              <span class="text-xs font-black text-orange-600 uppercase tracking-widest"> Gerencia · Móvil</span>
              <div class="w-2.5 h-2.5 bg-orange-500 rounded-full animate-ping"></div>
            </div>

            <div class="rounded-2xl overflow-hidden border border-gray-100 shadow-inner bg-stone-50 aspect-[9/16] max-w-[280px] mx-auto">
               <img
                src="/public/mobile-admin-view.webp"
                alt="Administración del establecimiento desde un smartphone"
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
          </div>

          <div class="mt-6 text-center">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors">Monitoreo en tiempo real</h3>
            <p class="text-gray-600 text-sm mt-2 leading-relaxed">
              Consulta ventas, cierres de turno y flujo de efectivo desde tu celular. Tu pizzería bajo control en todo momento.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Beneficios inferiores con animaciones de interacción -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="group text-center p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-orange-500/40 hover:-translate-y-1 transition-all duration-300">
        <div class="text-orange-400 text-2xl mb-3 transform group-hover:scale-125 transition-transform duration-300">●</div>
        <h4 class="font-bold text-white group-hover:text-orange-300 transition-colors">Sincronización total</h4>
        <p class="text-gray-400 text-sm mt-1 leading-relaxed">La información entre cocina y mostrador se actualiza instantáneamente.</p>
      </div>

      <div class="group text-center p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-300">
        <div class="text-amber-400 text-2xl mb-3 transform group-hover:scale-125 transition-transform duration-300">●</div>
        <h4 class="font-bold text-white group-hover:text-amber-300 transition-colors">Interfaz intuitiva</h4>
        <p class="text-gray-400 text-sm mt-1 leading-relaxed">Navegación clara y rápida para atender a tus clientes sin esperas.</p>
      </div>

      <div class="group text-center p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300">
        <div class="text-emerald-400 text-2xl mb-3 transform group-hover:scale-125 transition-transform duration-300">●</div>
        <h4 class="font-bold text-white group-hover:text-emerald-300 transition-colors">Acceso web</h4>
        <p class="text-gray-400 text-sm mt-1 leading-relaxed">Sin instalaciones complejas, accede desde cualquier navegador.</p>
      </div>
    </div>

  </div>
</section>