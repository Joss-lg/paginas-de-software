---
// Navbar.astro
---
<header class="fixed w-full bg-slate-900/90 backdrop-blur-md border-b border-slate-800 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo y Marca -->
      <div class="flex-shrink-0 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-400 flex items-center justify-center shadow-lg shadow-teal-500/20">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <!-- Texto del logo ajustado con colores más brillantes para contrastar en fondo oscuro -->
        <a href="/" class="text-2xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400 hover:opacity-80 transition-opacity">
          Ollintem
        </a>
      </div>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex space-x-2">
        <a href="#sistemas" class="px-4 py-2 text-sm font-semibold text-slate-300 rounded-full hover:text-teal-400 hover:bg-slate-800 transition-all">Sistemas</a>
        <a href="#funcionamiento" class="px-4 py-2 text-sm font-semibold text-slate-300 rounded-full hover:text-teal-400 hover:bg-slate-800 transition-all">Cómo Funciona</a>
        <a href="#reseñas" class="px-4 py-2 text-sm font-semibold text-slate-300 rounded-full hover:text-teal-400 hover:bg-slate-800 transition-all">Reseñas</a>
      </nav>

      <!-- Botón de Acción Desktop -->
      <div class="hidden md:flex items-center space-x-4">
        <!-- Botón principal contrastante (Esmeralda sobre fondo oscuro) -->
        <a href="#contacto" class="inline-flex items-center justify-center bg-teal-500 text-slate-900 px-6 py-2.5 rounded-full text-sm font-bold hover:bg-teal-400 transition-all shadow-lg shadow-teal-500/20 hover:shadow-teal-500/40 hover:-translate-y-0.5 group">
          Solicita tu Demo
          <svg class="ml-2 w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Menú Hamburguesa Mobile con CTA -->
      <div class="md:hidden flex items-center gap-3">
        <a href="#contacto" class="text-xs font-bold bg-teal-500 text-slate-900 px-4 py-2 rounded-full shadow-sm hover:bg-teal-400 transition-colors">
          Demo
        </a>
        <button class="p-2.5 rounded-xl text-slate-300 hover:text-teal-400 hover:bg-slate-800 focus:outline-none transition-colors" aria-label="Abrir menú">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      
    </div>
  </div>
</header>