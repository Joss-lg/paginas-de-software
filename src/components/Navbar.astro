<header class="fixed w-full bg-white/90 backdrop-blur-md shadow-sm z-50 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="text-2xl font-bold text-blue-600 tracking-tight">Ollintem SaaS</a>
      </div>
      <nav class="hidden md:flex space-x-8">
        <a href="#sistemas" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Sistemas</a>
        <a href="#funcionamiento" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Cómo Funciona</a>
        <a href="#planes" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Planes</a>
      </nav>
      <div class="hidden md:flex items-center space-x-4">
        <a href="#" class="text-blue-600 font-medium hover:text-blue-700">Iniciar Sesión</a>
        <a href="#planes" class="bg-blue-600 text-white px-5 py-2 rounded-full font-medium hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg">Comenzar</a>
