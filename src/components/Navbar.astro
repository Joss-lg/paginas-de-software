---
// Navbar.astro
---
<header class="fixed w-full bg-white/80 backdrop-blur-lg border-b border-slate-200/60 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo y Marca -->
      <div class="flex-shrink-0 flex items-center gap-3">
        <!-- Ícono del logo (puedes reemplazar el SVG por tu logo oficial) -->
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-400 flex items-center justify-center shadow-lg shadow-teal-500/20">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <a href="/" class="text-2xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-teal-800 to-emerald-600 hover:opacity-80 transition-opacity">
          Ollintem
        </a>
      </div>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex space-x-2">
        <a href="#sistemas" class="px-4 py-2 text-sm font-semibold text-slate-600 rounded-full hover:text-teal-700 hover:bg-teal-50 transition-all">Sistemas</a>
        <a href="#funcionamiento" class="px-4 py-2 text-sm font-semibold text-slate-600 rounded-full hover:text-teal-700 hover:bg-teal-50 transition-all">Cómo Funciona</a>
        <a href="#planes" class="px-4 py-2 text-sm font-semibold text-slate-600 rounded-full hover:text-teal-700 hover:bg-teal-50 transition-all">Planes</a>
      </nav>

      <!-- Botones de Acción Desktop -->
      <div class="hidden md:flex items-center space-x-6">
        <a href="/login" class="text-sm font-bold text-slate-600 hover:text-teal-700 transition-colors">
          Iniciar Sesión
        </a>
        <a href="#planes" class="bg-slate-900 text-white px-6 py-2.5 rounded-full text-sm font-bold hover:bg-teal-600 transition-all shadow-md hover:shadow-xl hover:shadow-teal-500/30 hover:-translate-y-0.5">
          Comenzar
        </a>
      </div>

      <!-- Menú Hamburguesa Mobile -->
      <div class="md:hidden flex items-center">
        <button class="p-2.5 rounded-xl text-slate-600 hover:text-teal-600 hover:bg-teal-50 focus:outline-none transition-colors" aria-label="Abrir menú">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      
    </div>
  </div>
</header>