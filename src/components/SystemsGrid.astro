---
// SystemsGrid.astro

const sistemas = [
  {
    title: "Pizzerías",
    description: "Control total de tu pizzería, desde la toma del pedido, comandas en cocina, hasta la entrega.",
    icon: "🍕",
    status: "disponible",
    link: "/pizzerias" 
  },
  {
    title: "Restaurantes",
    description: "Agiliza tu servicio de mesas y delivery con un sistema de comandas inteligente y rápido.",
    icon: "🍽️",
    status: "disponible",
    link: "/restaurantes"
  },
  {
    title: "Panaderías",
    description: "Gestión precisa de inventario de insumos, control de producción y venta ágil al mostrador.",
    icon: "🥖",
    status: "disponible",
    link: "/panaderias"
  },
  {
    title: "Control Escolar",
    description: "Administración integral de alumnos, calificaciones, colegiaturas y reportes académicos.",
    icon: "🎓",
    status: "disponible",
    link: "/escolar"
  },
  {
    title: "Abarroteras",
    description: "Punto de venta optimizado para alto volumen de transacciones y control de inventario masivo.",
    icon: "🛒",
    status: "disponible",
    link: "/abarrotera"
  },
  {
    title: "Ferreterías",
    description: "Gestión de miles de SKUs, cotizaciones dinámicas y facturación rápida en mostrador.",
    icon: "🛠️",
    status: "disponible",
    link: "/ferreteria"
  },
  {
    title: "Farmacias",
    description: "Manejo estricto de lotes, control de caducidades y dispensación de medicamentos.",
    icon: "💊",
    status: "disponible",
    link: "/farmacia"
  },
  {
    title: "Gimnasios",
    description: "Control de accesos, membresías recurrentes y administración de clases en tiempo real.",
    icon: "🏋️",
    status: "disponible",
    link: "/gimnasio"
  },
  {
    title: "Llanteras",
    description: "Gestión de inventario de neumáticos, órdenes de servicio de taller, cotizaciones y facturación ágil.",
    icon: "🛞",
    status: "disponible",
    link: "/llanteras"
  }
];
---

<section id="sistemas" class="relative py-32 bg-slate-900 overflow-hidden">
  
  <!-- Patrón de fondo y luces -->
  <div class="absolute inset-0 z-0 opacity-[0.05]" style="background-image: radial-gradient(#6EE7B7 1px, transparent 1px); background-size: 40px 40px;"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-teal-900/40 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Encabezado de la sección -->
    <div class="text-center mb-20">
      <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-slate-800 border border-slate-700 text-teal-400 text-sm font-bold mb-6 tracking-wide uppercase shadow-sm">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd" />
        </svg>
        Ecosistema SaaS
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">
        Catálogo de <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">Soluciones Empresariales</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Plataformas modulares con bases de datos relacionales de alto rendimiento. Arquitectura diseñada a la medida para escalar la operación de tu negocio.
      </p>
    </div>

    <!-- Grid de Sistemas (Matriz 3x3) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sistemas.map((sistema) => (
        <a 
          href={sistema.status === 'disponible' ? sistema.link : '#'} 
          class="group relative flex flex-col p-8 rounded-[2rem] bg-slate-800/40 backdrop-blur-xl border border-slate-700/50 hover:border-teal-500/50 transition-all duration-500 overflow-hidden hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(20,184,166,0.15)] z-10"
        >
          <!-- Efecto Glow interno en hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-teal-500/5 to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>

          <div class="flex justify-between items-start mb-8">
            <!-- Contenedor del Icono -->
            <div class="relative w-16 h-16 rounded-2xl bg-slate-900 border border-slate-700 flex items-center justify-center text-3xl shadow-inner group-hover:border-teal-500/30 transition-colors duration-500">
              <!-- Resplandor detrás del icono -->
              <div class="absolute inset-0 bg-teal-400/20 rounded-2xl blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <span class="relative z-10 transform group-hover:scale-110 transition-transform duration-500">{sistema.icon}</span>
            </div>

            <!-- Flecha superior derecha -->
            <div class="w-10 h-10 rounded-full bg-slate-800/50 flex items-center justify-center border border-slate-700 text-slate-500 group-hover:bg-teal-500 group-hover:text-slate-900 group-hover:border-teal-400 transition-all duration-500">
              <svg class="w-5 h-5 transform group-hover:rotate-45 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
          
          <!-- Textos -->
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-teal-400 transition-colors duration-300">
            {sistema.title}
          </h3>
          
          <p class="text-slate-400 text-base leading-relaxed flex-grow">
            {sistema.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>