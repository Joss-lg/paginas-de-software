---
// src/components/gimnasio/GymVideo.astro
const checklist = [
  "Registro de accesos con reconocimiento biométrico",
  "Cobro de membresías y control de adeudos",
  "Reportes de ingresos y asistencia en tiempo real"
];
---

<section class="py-24 bg-gym-bg text-gym-light relative overflow-hidden">

  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[400px] h-[400px] bg-gym-primary/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <!-- Video en marco tipo navegador -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-gym-light/10 shadow-2xl overflow-hidden bg-gym-card">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-gym-light/10">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <span class="ml-3 text-[10px] font-bold text-gym-light/30 uppercase tracking-widest">Demostración en vivo</span>
          </div>
          <div class="relative aspect-video group">
            <img
              src="https://placehold.co/1000x560/111625/7C6EEF?font=roboto&text=Accesos%2C+cobros+y+reportes+en+vivo"
              alt="Miniatura del video de demostración del sistema para gimnasios"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gym-bg/40 group-hover:bg-gym-bg/20 transition-colors"></div>
            <button class="absolute inset-0 flex items-center justify-center">
              <span class="w-16 h-16 rounded-full bg-gradient-to-r from-gym-primary to-gym-primary-light flex items-center justify-center shadow-lg shadow-gym-primary/40 group-hover:scale-110 transition-transform">
                <span class="text-white text-xl translate-x-0.5">▶</span>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- Texto + checklist -->
      <div class="lg:col-span-5">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gym-primary-light/10 border border-gym-primary-light/30 text-gym-primary-light text-xs font-semibold tracking-wide uppercase">
          Video de demostración
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold mt-4 mb-5 leading-tight">
          Mira el sistema operando en tiempo real
        </h2>
        <p class="text-gym-light/70 text-base md:text-lg mb-8">
          Un recorrido corto por lo que verás el día a día en recepción.
        </p>

        <ul class="space-y-4 mb-8">
          {checklist.map((item, i) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-gym-primary-light/15 text-gym-primary-light flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">{i + 1}</span>
              <span class="text-gym-light/80 text-sm sm:text-base">{item}</span>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-3 border-t border-gym-light/10 pt-6">
          <p class="text-2xl font-black text-gym-primary-light">2 min</p>
          <p class="text-xs text-gym-light/50 leading-tight">de video para<br />ver todo el flujo</p>
        </div>
      </div>

    </div>
  </div>
</section>