---
// src/components/gimnasio/GymVideo.astro
const checklist = [
  "Registro de accesos con reconocimiento biométrico",
  "Cobro de membresías y control de adeudos",
  "Reportes de ingresos y asistencia en tiempo real"
];
---

<!-- Fondo amarillo suave para cerrar con calidez -->
<section class="py-24 bg-[#FBBF24] text-[#1C1917] relative overflow-hidden">

  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[400px] h-[400px] bg-[#EAB308]/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <div class="lg:col-span-7">
        <!-- Contenedor del video con animación de agrandamiento e inclinación de -2° (izquierda) al hover -->
        <div class="rounded-2xl border border-[#1C1917]/15 shadow-xl overflow-hidden bg-white transition-all duration-300 ease-out transform hover:scale-105 hover:-rotate-2 cursor-pointer origin-center">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[#1C1917]/10 bg-neutral-50">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-300"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <span class="ml-3 text-[10px] font-bold text-[#1C1917]/50 uppercase tracking-widest">Demostración en vivo</span>
          </div>
          <div class="relative aspect-video group">
            <img
              src="https://placehold.co/1000x560/FFFFFF/1C1917?font=roboto&text=Accesos%2C+cobros+y+reportes"
              alt="Demostración en vivo"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-[#1C1917]/20 group-hover:bg-[#1C1917]/10 transition-colors"></div>
            <button class="absolute inset-0 flex items-center justify-center">
              <span class="w-16 h-16 rounded-full bg-[#EAB308] flex items-center justify-center shadow-lg shadow-[#EAB308]/40 group-hover:scale-110 transition-transform">
                <span class="text-[#1C1917] text-xl translate-x-0.5 font-bold">▶</span>
              </span>
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAB308]/15 border border-[#EAB308]/30 text-[#CA8A04] text-xs font-semibold tracking-wide uppercase">
          Video de demostración
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold mt-4 mb-5 leading-tight text-[#1C1917]">
          Mira el sistema operando en tiempo real
        </h2>
        <p class="text-[#1C1917]/75 text-base md:text-lg mb-8">
          Un recorrido corto por lo que verás el día a día en recepción.
        </p>

        <ul class="space-y-4 mb-8">
          {checklist.map((item, i) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-[#EAB308]/20 text-[#CA8A04] flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">{i + 1}</span>
              <span class="text-[#1C1917]/85 text-sm sm:text-base font-medium">{item}</span>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-4 border-t border-[#1C1917]/15 pt-6">
          <p class="text-3xl font-black text-[#CA8A04] font-mono">2 min</p>
          <p class="text-xs text-[#1C1917]/60 leading-tight">de video para<br />ver todo el flujo</p>
        </div>
      </div>

    </div>
  </div>
</section>