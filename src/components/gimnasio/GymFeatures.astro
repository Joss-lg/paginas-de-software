---
// src/components/gimnasio/GymFeatures.astro
const features = [
  {
    code: "FIN",
    title: "Control Financiero y Caja",
    description: "Monitorea ingresos diarios, cortes de caja automáticos, control de adeudos y reportes de rentabilidad en tiempo real."
  },
  {
    code: "ACC",
    title: "Control de Acceso Biométrico",
    description: "Sincronización con torniquetes, reconocimiento facial y huella dactilar para bloquear automáticamente membresías vencidas."
  },
  {
    code: "APP",
    title: "App Móvil para Socios",
    description: "Tus clientes podrán reservar clases grupales, ver sus rutinas asignadas, historial de pagos y rutinas personalizadas."
  },
  {
    code: "CLS",
    title: "Gestión de Rutinas y Clases",
    description: "Asigna entrenamientos avanzados, programa capacidad máxima en áreas comunes y controla instructores sin fricción."
  }
];
---

<section id="caracteristicas" class="py-24 bg-gym-bg text-gym-light relative overflow-hidden">

  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-gym-primary/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="grid lg:grid-cols-12 gap-12 mb-16 items-end">
      <div class="lg:col-span-7">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-gym-primary-light mb-4">// Potencia operativa</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          Todo lo que necesitas para operar en piloto automático
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="text-gym-light/70 text-base sm:text-lg">
          Diseñado específicamente para eliminar cuellos de botella administrativos y escalar tu negocio fitness.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-12">

      <!-- Lista de características estilo terminal -->
      <div class="lg:col-span-7 border-t border-gym-light/10">
        {features.map((feature) => (
          <div class="group flex items-start gap-6 py-7 border-b border-gym-light/10 hover:bg-gym-light/[0.02] transition-colors duration-300 pl-4 -ml-4 border-l-2 border-l-transparent hover:border-l-gym-primary-light">
            <span class="font-mono text-xs text-gym-primary-light/70 tracking-widest pt-1.5 flex-shrink-0 w-10">{feature.code}</span>
            <div>
              <h3 class="text-xl font-bold text-white group-hover:text-gym-primary-light transition-colors">
                {feature.title}
              </h3>
              <p class="text-sm text-gym-light/60 leading-relaxed mt-2 max-w-lg">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Espacio de imagen: reemplaza por una captura real del panel -->
      <div class="lg:col-span-5">
        <div class="relative lg:sticky lg:top-24">
          <div class="absolute -top-px -left-px w-6 h-6 border-t-2 border-l-2 border-gym-primary-light z-20"></div>
          <div class="absolute -top-px -right-px w-6 h-6 border-t-2 border-r-2 border-gym-primary-light z-20"></div>
          <div class="absolute -bottom-px -left-px w-6 h-6 border-b-2 border-l-2 border-gym-primary-light z-20"></div>
          <div class="absolute -bottom-px -right-px w-6 h-6 border-b-2 border-r-2 border-gym-primary-light z-20"></div>
          <div class="overflow-hidden border border-gym-light/10">
            <img
              src="https://placehold.co/700x900/171d30/7C6EEF?font=roboto&text=Panel+de+funciones+en+acci%C3%B3n"
              alt="Espacio para captura de pantalla del panel de funciones"
              class="w-full h-[560px] object-cover"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>