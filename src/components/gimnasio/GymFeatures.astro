---
// src/components/gimnasio/GymFeatures.astro
const features = [
  {
    code: "FIN",
    title: "Control Financiero y Caja",
    description: "Monitorea ingresos diarios, cortes de caja automáticos, control de adeudos y reportes de rentabilidad en tiempo real."
  },
  {
    code: "ACC",
    title: "Control de Acceso Biométrico",
    description: "Sincronización con torniquetes, reconocimiento facial y huella dactilar para bloquear automáticamente membresías vencidas."
  },
  {
    code: "APP",
    title: "App Móvil para Socios",
    description: "Tus clientes podrán reservar clases grupales, ver sus rutinas asignadas, historial de pagos y rutinas personalizadas."
  },
  {
    code: "CLS",
    title: "Gestión de Rutinas y Clases",
    description: "Asigna entrenamientos avanzados, programa capacidad máxima en áreas comunes y controla instructores sin fricción."
  }
];
---

<section id="caracteristicas" class="py-24 bg-white text-[#1C1917] relative overflow-hidden">

  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#EAB308]/5 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="grid lg:grid-cols-12 gap-12 mb-16 items-end">
      <div class="lg:col-span-7">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#CA8A04] mb-4">// Potencia operativa</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1C1917]">
          Todo lo que necesitas para operar en piloto automático
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="text-[#1C1917]/70 text-base sm:text-lg">
          Diseñado específicamente para eliminar cuellos de botella administrativos y escalar tu negocio fitness.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 items-start">

      <div class="lg:col-span-7 space-y-4">
        {features.map((feature) => (
          <div class="group flex items-start gap-6 p-6 bg-white border border-[#1C1917]/10 rounded-xl hover:border-[#EAB308] transition-all duration-300 shadow-sm">
            <span class="font-mono text-xs text-[#CA8A04] font-bold tracking-widest pt-1.5 flex-shrink-0 w-10">{feature.code}</span>
            <div>
              <h3 class="text-xl font-bold text-[#1C1917] group-hover:text-[#CA8A04] transition-colors">
                {feature.title}
              </h3>
              <p class="text-sm text-[#1C1917]/70 leading-relaxed mt-2">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="lg:col-span-5">
        <div class="relative lg:sticky lg:top-24 rounded-2xl overflow-hidden shadow-xl border border-[#1C1917]/10 bg-white p-2">
          <div class="absolute -top-px -left-px w-6 h-6 border-t-2 border-l-2 border-[#EAB308] z-20"></div>
          <div class="absolute -top-px -right-px w-6 h-6 border-t-2 border-r-2 border-[#EAB308] z-20"></div>
          <div class="absolute -bottom-px -left-px w-6 h-6 border-b-2 border-l-2 border-[#EAB308] z-20"></div>
          <div class="absolute -bottom-px -right-px w-6 h-6 border-b-2 border-r-2 border-[#EAB308] z-20"></div>
          <div class="overflow-hidden rounded-xl">
            <img
              src="https://placehold.co/700x900/FFFFFF/1C1917?font=roboto&text=Panel+de+funciones"
              alt="Panel de funciones"
              class="w-full h-[540px] object-cover"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>