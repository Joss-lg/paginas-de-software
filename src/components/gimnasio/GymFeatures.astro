---
// src/components/gimnasio/GymFeatures.astro
const features = [
  {
    code: "FIN",
    title: "Control Financiero y Caja",
    description: "Monitorea ingresos diarios, cortes de caja automáticos, control de adeudos y reportes de rentabilidad en tiempo real."
  },
  {
    code: "ACC",
    title: "Control de Acceso Biométrico",
    description: "Sincronización con torniquetes, reconocimiento facial y huella dactilar para bloquear automáticamente membresías vencidas."
  },
  {
    code: "APP",
    title: "App Móvil para Socios",
    description: "Tus clientes podrán reservar clases grupales, ver sus rutinas asignadas, historial de pagos y rutinas personalizadas."
  },
  {
    code: "CLS",
    title: "Gestión de Rutinas y Clases",
    description: "Asigna entrenamientos avanzados, programa capacidad máxima en áreas comunes y controla instructores sin fricción."
  }
];
---

<section id="caracteristicas" class="py-24 bg-white text-[#1C1917] relative overflow-hidden">

  <!-- Resplandor ambiental y fondo de micro-puntos inspirado en la interfaz -->
  <div class="absolute inset-0 bg-[radial-gradient(#1C1917_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#fae364]/20 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="grid lg:grid-cols-12 gap-12 mb-16 items-end">
      <div class="lg:col-span-7">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#1C1917] mb-4 inline-flex items-center gap-2 px-3.5 py-1.5 bg-gradient-to-r from-[#ffd78c] to-[#fae364] border border-[#1C1917]/20 rounded-full shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#1C1917]"></span> // Potencia operativa
        </h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1C1917]">
          Todo lo que necesitas para operar en piloto automático
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="text-[#1C1917]/70 text-base sm:text-lg">
          Diseñado específicamente para eliminar cuellos de botella administrativos y escalar tu negocio fitness.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 items-start">

      <!-- Columna izquierda: Tarjetas con base #ffd78c y #fae364, estética UI moderna y hover interactivo -->
      <div class="lg:col-span-7 space-y-4">
        {features.map((feature) => (
          <div class="group flex items-start gap-6 p-6 bg-gradient-to-r from-[#ffd78c] to-[#fae364] border border-[#1C1917]/15 rounded-xl transition-all duration-300 shadow-xs hover:shadow-[0_10px_25px_rgba(250,227,100,0.45)] hover:border-[#1C1917]/40 transform hover:scale-[1.02] cursor-pointer">
            <span class="font-mono text-xs font-bold tracking-widest flex-shrink-0 w-11 py-1.5 px-1 text-center bg-[#1C1917] text-[#fae364] rounded-md transition-transform duration-300 group-hover:scale-110 shadow-xs">
              {feature.code}
            </span>
            <div>
              <h3 class="text-xl font-bold text-[#1C1917] transition-colors">
                {feature.title}
              </h3>
              <p class="text-sm text-[#1C1917]/80 leading-relaxed mt-2 font-medium">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Columna derecha: Tarjeta contenedora basada en #ffd78c y #fae364 con encuadre técnico -->
      <div class="lg:col-span-5">
        <div class="relative lg:sticky lg:top-24 rounded-2xl overflow-hidden shadow-xl border border-[#1C1917]/15 bg-gradient-to-br from-[#ffd78c] to-[#fae364] p-3 transition-all duration-300 ease-out hover:shadow-[0_15px_35px_rgba(250,227,100,0.5)] hover:border-[#1C1917]/40 transform hover:scale-105 hover:rotate-2 cursor-pointer origin-center">
          
          <!-- Esquinas estilo visor técnico oscuras mimetizadas con la imagen -->
          <div class="absolute top-1.5 left-1.5 w-5 h-5 border-t-2 border-l-2 border-[#1C1917] z-20"></div>
          <div class="absolute top-1.5 right-1.5 w-5 h-5 border-t-2 border-r-2 border-[#1C1917] z-20"></div>
          <div class="absolute bottom-1.5 left-1.5 w-5 h-5 border-b-2 border-l-2 border-[#1C1917] z-20"></div>
          <div class="absolute bottom-1.5 right-1.5 w-5 h-5 border-b-2 border-r-2 border-[#1C1917] z-20"></div>
          
          <div class="overflow-hidden rounded-xl border border-[#1C1917]/10 bg-white/90">
            <img
              src="https://placehold.co/700x900/FEFCE8/1C1917?font=roboto&text=Panel+de+funciones"
              alt="Panel de funciones"
              class="w-full h-[540px] object-cover"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>