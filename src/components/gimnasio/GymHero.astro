---
// src/components/gimnasio/Hero.astro
---

<section class="relative min-h-[90vh] bg-gradient-to-br from-[#FACC15] via-[#EAB308] to-[#CA8A04] text-[#1C1917] overflow-hidden flex items-center pt-24 pb-16 px-4 sm:px-6 lg:px-8">

  <style is:global>
    @keyframes blink-gym {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    @keyframes repLift {
      0%, 15% { transform: translateY(0); animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }
      35%, 50% { transform: translateY(-110px); animation-timing-function: cubic-bezier(0.4, 0, 1, 1); }
      75%, 100% { transform: translateY(0); }
    }
    @keyframes repSpin {
      0%, 15% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }
      35%, 50% { transform: rotate(360deg); animation-timing-function: cubic-bezier(0.4, 0, 1, 1); }
      75%, 100% { transform: rotate(0deg); }
    }
    @keyframes repCable {
      0%, 15% { transform: scaleY(1); animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }
      35%, 50% { transform: scaleY(0.5); animation-timing-function: cubic-bezier(0.4, 0, 1, 1); }
      75%, 100% { transform: scaleY(1); }
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.05); }
    }
    .animate-blink-gym { animation: blink-gym 1.6s ease-in-out infinite; }
    .animate-rep-lift { animation: repLift 4.5s infinite; }
    .animate-rep-spin { animation: repSpin 4.5s infinite; }
    .animate-rep-cable { animation: repCable 4.5s infinite; }
    .animate-pulse-glow { animation: pulseGlow 4s ease-in-out infinite; }
    
    @media (prefers-reduced-motion: reduce) {
      .animate-blink-gym, .animate-rep-lift, .animate-rep-spin, .animate-rep-cable, .animate-pulse-glow { animation: none !important; }
    }
  </style>

  <div
    class="absolute inset-0 opacity-[0.1] pointer-events-none"
    style="background-image: radial-gradient(circle, #1C1917 1.2px, transparent 1.2px); background-size: 32px 32px;"
  ></div>

  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-white/20 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto w-full relative z-10">

    <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/80 border border-[#1C1917]/15 font-mono text-[11px] tracking-widest text-[#1C1917] mb-10 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#1C1917] animate-blink-gym"></span>
      <span>SISTEMA_EN_LINEA</span>
      <span class="text-[#1C1917]/30">/</span>
      <span class="font-bold">BUILD_4.2.0_GYM</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] text-[#1C1917]">
          Revoluciona la gestión de tu <span class="text-white drop-shadow-sm">Gimnasio</span>
        </h1>

        <p class="text-lg sm:text-xl text-[#1C1917]/80 max-w-2xl mx-auto lg:mx-0 font-medium">
          Automatiza accesos, controla membresías, optimiza cobros y potencia el rendimiento de tus atletas desde una plataforma inteligente y ultrarrápida.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
          <a href="#planes" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white text-[#1C1917] font-bold shadow-lg shadow-black/10 hover:bg-[#1C1917] hover:text-white hover:scale-105 transition-all duration-300 text-center">
            Comenzar Prueba Gratis
          </a>
          <a href="#caracteristicas" class="w-full sm:w-auto px-8 py-4 rounded-xl border-2 border-[#1C1917]/25 text-[#1C1917] font-semibold hover:bg-white/40 transition-all duration-300 text-center">
            Ver Demostración
          </a>
        </div>

        <div class="flex justify-center lg:justify-start divide-x divide-[#1C1917]/20 pt-8 border-t border-[#1C1917]/15 max-w-lg mx-auto lg:mx-0 font-mono">
          <div class="px-5 first:pl-0">
            <p class="text-2xl sm:text-3xl font-black text-[#1C1917]">+99%</p>
            <p class="text-[10px] text-[#1C1917]/70 uppercase tracking-wider mt-1">Retención</p>
          </div>
          <div class="px-5">
            <p class="text-2xl sm:text-3xl font-black text-[#1C1917]">24/7</p>
            <p class="text-[10px] text-[#1C1917]/70 uppercase tracking-wider mt-1">Soporte Cloud</p>
          </div>
          <div class="px-5">
            <p class="text-2xl sm:text-3xl font-black text-[#1C1917]">10K+</p>
            <p class="text-[10px] text-[#1C1917]/70 uppercase tracking-wider mt-1">Atletas Activos</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">

          <div class="relative">
            <div class="absolute -top-px -left-px w-6 h-6 border-t-2 border-l-2 border-[#1C1917] z-20"></div>
            <div class="absolute -top-px -right-px w-6 h-6 border-t-2 border-r-2 border-[#1C1917] z-20"></div>
            <div class="absolute -bottom-px -left-px w-6 h-6 border-b-2 border-l-2 border-[#1C1917] z-20"></div>
            <div class="absolute -bottom-px -right-px w-6 h-6 border-b-2 border-r-2 border-[#1C1917] z-20"></div>

            <div class="relative w-full h-[420px] sm:h-[460px] bg-white border border-[#1C1917]/20 overflow-hidden flex flex-col items-center rounded-2xl shadow-2xl">
              
              <div class="absolute top-12 left-6 w-24 h-16 bg-[#FAFAF9] border border-[#1C1917]/10 rounded-lg p-2 flex flex-col justify-between animate-pulse-glow pointer-events-none shadow-sm">
                <span class="text-[8px] font-mono text-[#1C1917]/50">ZONA_A</span>
                <span class="text-[10px] font-mono font-bold text-[#CA8A04]">SYNC_OK</span>
              </div>
              <div class="absolute top-12 right-6 w-24 h-16 bg-yellow-50 border border-yellow-200 rounded-lg p-2 flex flex-col justify-between animate-pulse-glow [animation-delay:1.5s] pointer-events-none shadow-sm">
                <span class="text-[8px] font-mono text-[#1C1917]/50">FLOW_RATE</span>
                <span class="text-[10px] font-mono font-bold text-yellow-700">98.4%</span>
              </div>
              <div class="absolute bottom-12 left-6 w-24 h-12 bg-white border border-[#1C1917]/10 rounded-lg px-2.5 flex items-center justify-between pointer-events-none shadow-sm">
                <span class="text-[8px] font-mono text-[#1C1917]/60">NODE</span>
                <span class="w-2 h-2 rounded-full bg-[#EAB308]"></span>
              </div>
              <div class="absolute bottom-12 right-6 w-24 h-12 bg-white border border-[#1C1917]/10 rounded-lg px-2.5 flex items-center justify-between pointer-events-none shadow-sm">
                <span class="text-[8px] font-mono text-[#1C1917]/60">PING</span>
                <span class="text-[9px] font-mono text-yellow-700 font-bold">12ms</span>
              </div>

              <div class="absolute inset-0 bg-gradient-to-b from-[#EAB308]/10 via-transparent to-[#EAB308]/10 pointer-events-none"></div>

              <div class="absolute top-4 left-1/2 -translate-x-1/2 flex flex-col items-center z-25">
                <div class="w-20 h-2 bg-[#1C1917]/20 rounded-t-sm shadow-inner"></div>
                <div class="w-10 h-6 bg-[#FAFAF9] border-x border-b border-[#1C1917]/20 flex justify-center items-center">
                  <div class="w-2 h-2 rounded-full bg-[#EAB308]"></div>
                </div>
                
                <div class="relative w-16 h-16 rounded-full border-4 border-[#1C1917]/10 border-t-[#EAB308] border-b-[#1C1917] flex items-center justify-center animate-rep-spin shadow-[0_0_15px_rgba(234,179,8,0.3)] mt-[-4px] bg-white">
                  <div class="w-4 h-4 rounded-full bg-[#EAB308] flex items-center justify-center">
                    <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
                  </div>
                  <div class="absolute w-full h-0.5 bg-[#1C1917]/10"></div>
                  <div class="absolute h-full w-0.5 bg-[#1C1917]/10"></div>
                </div>
              </div>

              <div class="absolute top-12 bottom-0 left-[28%] sm:left-[32%] w-1.5 bg-gradient-to-r from-[#1C1917]/5 via-[#1C1917]/15 to-[#1C1917]/5 shadow-inner"></div>
              <div class="absolute top-12 bottom-0 right-[28%] sm:right-[32%] w-1.5 bg-gradient-to-r from-[#1C1917]/5 via-[#1C1917]/15 to-[#1C1917]/5 shadow-inner"></div>

              <div class="absolute top-[88px] left-1/2 -translate-x-1/2 w-1 bg-gradient-to-b from-[#1C1917]/40 to-[#1C1917]/20 h-[220px] z-10 shadow-[0_0_6px_rgba(0,0,0,0.1)] origin-top animate-rep-cable"></div>

              <div class="absolute bottom-6 w-[55%] sm:w-[50%] flex flex-col items-center z-30">
                
                <div class="w-full flex flex-col items-center animate-rep-lift relative z-40">
                  <div class="w-5 h-6 bg-[#1C1917]/20 rounded-t-md border-x border-t border-[#1C1917]/30 mb-1 flex justify-center pt-1.5">
                    <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
                  </div>

                  <div class="w-full h-12 bg-[#FAFAF9] border border-[#EAB308]/70 rounded-lg flex items-center justify-between px-3 shadow-md mb-1 relative overflow-hidden">
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#EAB308]"></div>
                    <div class="flex items-center gap-2">
                      <div class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-yellow-500"></span>
                      </div>
                      <div class="flex flex-col">
                        <span class="text-[8px] font-mono text-[#1C1917]/60 tracking-wider">ESTADO</span>
                        <span class="text-[10px] font-mono text-[#1C1917] font-bold">MEMBRESÍA</span>
                      </div>
                    </div>
                    <span class="text-[10px] font-mono font-bold text-[#1C1917]">#805</span>
                  </div>

                  <div class="w-full h-8 bg-white border border-[#1C1917]/15 rounded-md flex items-center justify-end px-3 mb-1 shadow-sm">
                    <span class="text-[9px] font-mono text-[#1C1917]/50 font-semibold">120 LBS</span>
                  </div>
                  <div class="w-full h-8 bg-white border border-[#1C1917]/15 rounded-md flex items-center justify-end px-3 shadow-sm relative">
                    <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-[#EAB308] shadow-[0_0_8px_rgba(234,179,8,0.8)] border border-white"></div>
                    <span class="text-[9px] font-mono text-[#1C1917]/50 font-semibold mr-1.5">100 LBS</span>
                  </div>
                </div>

                <div class="w-full flex flex-col items-center pt-1 relative z-30">
                  <div class="w-full h-8 bg-[#FAFAF9] border border-[#1C1917]/10 rounded-md flex items-center justify-end px-3 mb-1">
                    <span class="text-[9px] font-mono text-[#1C1917]/30">80 LBS</span>
                  </div>
                  <div class="w-full h-8 bg-[#FAFAF9] border border-[#1C1917]/10 rounded-md flex items-center justify-end px-3">
                    <span class="text-[9px] font-mono text-[#1C1917]/30">60 LBS</span>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <div class="mt-4 bg-white/90 backdrop-blur-sm border border-[#1C1917]/15 divide-y divide-[#1C1917]/10 font-mono text-[11px] rounded-xl shadow-md overflow-hidden relative z-20">
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-[#1C1917]/60">14:32:01</span>
              <span class="text-[#1C1917] font-medium">Acceso concedido — C. Mendoza</span>
              <span class="w-2 h-2 rounded-full bg-yellow-600 flex-shrink-0"></span>
            </div>
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-[#1C1917]/60">14:31:47</span>
              <span class="text-[#1C1917] font-medium">Pago recibido — $850.00 MXN</span>
              <span class="w-2 h-2 rounded-full bg-[#EAB308] flex-shrink-0"></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>