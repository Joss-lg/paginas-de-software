---
// src/components/gimnasio/Pricing.astro
const plans = [
  {
    name: "Starter Gym",
    price: "$49",
    period: "mes",
    description: "Ideal para estudios independientes y gimnasios pequeños.",
    features: [
      "Hasta 300 socios activos",
      "Control de accesos básico",
      "Punto de venta (POS)",
      "Soporte vía ticket",
      "1 usuario administrador"
    ],
    highlighted: false
  },
  {
    name: "Pro Fitness Club",
    price: "$99",
    period: "mes",
    description: "Para centros deportivos en crecimiento y alta rotación.",
    features: [
      "Socios ilimitados",
      "Control biométrico avanzado",
      "App móvil personalizada",
      "Reportes financieros detallados",
      "Soporte prioritario 24/7",
      "Hasta 5 usuarios administrativos"
    ],
    highlighted: true
  },
  {
    name: "Enterprise Franchise",
    price: "$199",
    period: "mes",
    description: "Solución completa para cadenas y franquicias multi-sucursal.",
    features: [
      "Multi-sucursal ilimitada",
      "API de integración abierta",
      "Automatización de cobros recurrentes",
      "Gerente de cuenta dedicado",
      "Personalización total de marca (White Label)"
    ],
    highlighted: false
  }
];
---

<section id="planes" class="py-24 bg-gym-bg text-gym-light relative overflow-hidden">

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gym-primary/10 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-gym-primary-light">// Inversión inteligente</h2>
      <p class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Planes transparentes adaptados a tu escala
      </p>
      <p class="text-gym-light/70 text-base sm:text-lg">
        Sin contratos forzosos. Cancela o cambia de plan cuando lo necesites.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border border-gym-light/10">
      {plans.map((plan, i) => (
        <div class={`relative flex flex-col justify-between p-8 ${
          i !== plans.length - 1 ? 'lg:border-r border-gym-light/10' : ''
        } ${plan.highlighted ? 'bg-gym-primary/10' : ''}`}>

          {plan.highlighted && (
            <div class="absolute top-0 right-0 bg-gym-primary-light text-gym-bg text-[10px] font-mono font-bold uppercase tracking-widest px-3 py-1.5">
              Más elegido
            </div>
          )}

          <div>
            <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
            <p class="text-sm text-gym-light/60 mb-6 min-h-[40px]">{plan.description}</p>

            <div class="flex items-baseline gap-1 mb-8 font-mono">
              <span class="text-5xl font-black text-white">{plan.price}</span>
              <span class="text-sm text-gym-light/50">/{plan.period}</span>
            </div>

            <ul class="space-y-3.5 mb-10">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-gym-light/80">
                  <span class="font-mono text-gym-primary-light mt-0.5">+</span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <a href="#" class={`w-full py-3.5 font-bold text-center transition-all duration-300 block border ${
            plan.highlighted
              ? 'bg-gym-primary-light text-gym-bg border-gym-primary-light hover:opacity-90'
              : 'border-gym-light/20 text-white hover:border-gym-primary-light hover:text-gym-primary-light'
          }`}>
            Elegir plan
          </a>

        </div>
      ))}
    </div>

  </div>
</section>