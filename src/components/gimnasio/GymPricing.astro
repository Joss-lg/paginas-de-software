---
// src/components/gimnasio/Pricing.astro
const plans = [
  {
    name: "Starter Gym",
    price: "$49",
    period: "mes",
    description: "Ideal para estudios independientes y gimnasios pequeños.",
    features: [
      "Hasta 300 socios activos",
      "Control de accesos básico",
      "Punto de venta (POS)",
      "Soporte vía ticket",
      "1 usuario administrador"
    ],
    highlighted: false
  },
  {
    name: "Pro Fitness Club",
    price: "$99",
    period: "mes",
    description: "Para centros deportivos en crecimiento y alta rotación.",
    features: [
      "Socios ilimitados",
      "Control biométrico avanzado",
      "App móvil personalizada",
      "Reportes financieros detallados",
      "Soporte prioritario 24/7",
      "Hasta 5 usuarios administrativos"
    ],
    highlighted: true
  },
  {
    name: "Enterprise Franchise",
    price: "$199",
    period: "mes",
    description: "Solución completa para cadenas y franquicias multi-sucursal.",
    features: [
      "Multi-sucursal ilimitada",
      "API de integración abierta",
      "Automatización de cobros recurrentes",
      "Gerente de cuenta dedicado",
      "Personalización total de marca (White Label)"
    ],
    highlighted: false
  }
];
---

<section id="planes" class="py-24 bg-white text-[#1C1917] relative overflow-hidden">

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#EAB308]/5 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#CA8A04]">// Inversión inteligente</h2>
      <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1C1917]">
        Planes transparentes adaptados a tu escala
      </p>
      <p class="text-[#1C1917]/70 text-base sm:text-lg">
        Sin contratos forzosos. Cancela o cambia de plan cuando lo necesites.
      </p>
    </div>

    <!-- Contenedor separado con gap entre tarjetas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {plans.map((plan) => (
        <div class={`relative flex flex-col justify-between p-8 rounded-2xl border transition-all duration-300 transform hover:scale-105 cursor-pointer overflow-hidden ${
          plan.highlighted 
            ? 'bg-[#1C1917] text-white border-[#EAB308] ring-2 ring-[#EAB308] shadow-2xl z-10 hover:shadow-[0_0_30px_rgba(234,179,8,0.25)]' 
            : 'bg-white text-[#1C1917] border-[#1C1917]/15 shadow-xl hover:border-[#EAB308] hover:shadow-2xl'
        }`}>

          {plan.highlighted && (
            <div class="absolute top-0 right-0 bg-[#EAB308] text-[#1C1917] text-[10px] font-mono font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-bl-xl rounded-tr-2xl shadow-sm">
              Más elegido
            </div>
          )}

          <div>
            <span class={`inline-block font-mono text-xs uppercase tracking-widest px-3 py-1 rounded-full mb-4 ${
              plan.highlighted ? 'bg-[#EAB308]/20 text-[#EAB308]' : 'bg-[#EAB308]/10 text-[#CA8A04]'
            }`}>
              {plan.highlighted ? 'Avanzado' : 'Paquete'}
            </span>

            <h3 class={`text-xl font-bold mb-2 ${plan.highlighted ? 'text-white' : 'text-[#1C1917]'}`}>{plan.name}</h3>
            <p class={`text-sm mb-6 min-h-[40px] ${plan.highlighted ? 'text-white/70' : 'text-[#1C1917]/70'}`}>{plan.description}</p>

            <div class="flex items-baseline gap-1 mb-8 font-mono">
              <span class={`text-5xl font-black ${plan.highlighted ? 'text-white' : 'text-[#1C1917]'}`}>{plan.price}</span>
              <span class={`text-sm ${plan.highlighted ? 'text-white/50' : 'text-[#1C1917]/55'}`}>/{plan.period}</span>
            </div>

            <ul class="space-y-3.5 mb-10">
              {plan.features.map((feature) => (
                <li class={`flex items-start gap-3 text-sm ${plan.highlighted ? 'text-white/90' : 'text-[#1C1917]/80'}`}>
                  <span class={`font-mono font-bold mt-0.5 ${plan.highlighted ? 'text-[#EAB308]' : 'text-[#CA8A04]'}`}>✓</span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <a href="#" class={`w-full py-4 font-bold text-center rounded-xl transition-all duration-300 block shadow-sm ${
            plan.highlighted
              ? 'bg-[#EAB308] text-[#1C1917] hover:bg-[#FACC15] shadow-[#EAB308]/25'
              : 'border border-[#1C1917]/20 text-[#1C1917] hover:bg-[#EAB308]/10 hover:border-[#EAB308]'
          }`}>
            {plan.highlighted ? 'Adquirir Pro' : 'Elegir plan'}
          </a>

        </div>
      ))}
    </div>

  </div>
</section>