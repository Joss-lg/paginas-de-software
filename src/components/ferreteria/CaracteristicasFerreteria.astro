---
// src/components/ferreteria/CaracteristicasFerreteria.astro
const funciones = [
  {
    titulo: "Búsqueda Inteligente",
    descripcion: "Encuentra productos por nombre, marcas o categorías al instante.",
    icono: "🔍"
  },
  {
    titulo: "Control de Stock",
    descripcion: "Mantén un registro preciso y actualizado de la mercancía en tiempo real.",
    icono: "📊"
  },
  {
    titulo: "Alertas de Stock Mínimo",
    descripcion: "Evita quedarte sin productos de alta rotación con notificaciones automáticas.",
    icono: "📦"
  }
];
---

<section id="caracteristicas" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
        Un sistema de inventario para controlar el ritmo de tu negocio
      </h2>
      <p class="mt-4 text-slate-600 text-lg">
        Herramientas para simplificar la atención al cliente en mostrador y evitar pérdidas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {funciones.map((f) => (
        <div class="p-8 rounded-2xl bg-purple-50/50 border border-purple-100 hover:border-purple-300 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/10">
          <div class="text-4xl mb-4">{f.icono}</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">{f.titulo}</h3>
          <p class="text-slate-600 leading-relaxed text-sm">{f.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>