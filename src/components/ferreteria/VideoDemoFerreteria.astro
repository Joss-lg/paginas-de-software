---
// src/components/ferreteria/VideoDemoFerreteria.astro
interface Props {
  videoUrl?: string;
}

const { videoUrl = "" } = Astro.props;
---

<section id="demo" class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold uppercase tracking-wider mb-4 border border-purple-200">
      Demostración en Video
    </div>
    <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl mb-8">
      Mira el sistema en acción en tiempo real
    </h2>

    <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border-2 border-dashed border-purple-300 bg-slate-900 flex flex-col items-center justify-center p-6 text-white group">
      {videoUrl ? (
        <iframe 
          class="w-full h-full"
          src={videoUrl} 
          title="Demostración del sistema" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      ) : (
        <div class="flex flex-col items-center justify-center space-y-4">
          <div class="w-16 h-16 rounded-full bg-purple-600/30 border border-purple-400/40 flex items-center justify-center text-purple-300 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
          <p class="text-slate-300 font-medium text-base">
            Espacio reservado para el video demostrativo del sistema
          </p>
          <span class="text-xs text-purple-300/70 font-mono bg-purple-950/60 px-3 py-1 rounded-md border border-purple-800/50">
            Pasa la propiedad <code class="text-purple-200">videoUrl</code> para activar el reproductor
          </span>
        </div>
      )}
    </div>
  </div>
</section>