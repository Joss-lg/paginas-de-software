---
// src/components/ferreteria/PlanesFerreteria.astro
const planesOriginales = [
  {
    nombre: "Inicial",
    precioMensual: "$599",
    descripcion: "Ideal para negocios pequeños que van comenzando.",
    caracteristicas: [
      "1 Punto de venta (Caja)",
      "Hasta 5,000 productos",
      "Control de inventario básico",
      "Ventas rápidas de mostrador",
      "Soporte por correo"
    ],
    ctaText: "Comenzar Plan Inicial",
    ctaHref: "#contacto"
  },
  {
    nombre: "Profesional",
    popular: true,
    precioMensual: "$999",
    descripcion: "La solución completa para mostradores con alto flujo de clientes.",
    caracteristicas: [
      "Cajas e impresoras ilimitadas",
      "Catálogo ilimitado de productos",
      "Gestión de créditos a clientes",
      "Alertas de stock mínimo",
      "Soporte prioritario 24/7"
    ],
    ctaText: "Probar Gratis 14 Días",
    ctaHref: "#contacto"
  },
  {
    nombre: "Empresarial",
    precioMensual: "$1,299",
    descripcion: "Para negocios con múltiples sucursales que necesitan sincronización.",
    caracteristicas: [
      "Todo lo incluido en Plan Profesional",
      "Múltiples sucursales y almacenes",
      "Transferencias de stock entre tiendas",
      "Reportes consolidados en la nube",
      "Ajustes masivos por XML/Excel",
      "Asesor dedicado"
    ],
    ctaText: "Contactar Ventas",
    ctaHref: "#contacto"
  }
];
---

<section id="planes" class="py-24 bg-white text-slate-900 border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-purple-600 font-extrabold text-sm uppercase tracking-wider">Planes y Precios</span>
      <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl mt-2 tracking-tight">
        Un sistema flexible adaptado al tamaño de tu negocio
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg">
        Sin plazos forzosos. Cancela o cambia de plan en cualquier momento.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {planesOriginales.map((plan) => (
        <div class={`relative flex flex-col justify-between p-8 rounded-3xl transition-all duration-300 ${
          plan.popular 
            ? 'bg-black text-white border-2 border-purple-600 shadow-2xl shadow-purple-950/30 lg:-translate-y-2 hover:border-purple-500 hover:shadow-purple-950/50' 
            : 'bg-white text-slate-900 border border-slate-200 shadow-md hover:border-2 hover:border-purple-600 hover:shadow-xl hover:shadow-purple-500/10 hover:-translate-y-1'
        }`}>
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-purple-600 text-white text-xs font-black uppercase tracking-wider rounded-full shadow-md shadow-purple-600/40">
              Más Popular
            </div>
          )}

          <div>
            <h3 class={`text-2xl font-black mb-2 ${plan.popular ? 'text-white' : 'text-slate-900'}`}>{plan.nombre}</h3>
            <p class={`text-sm min-h-[40px] mb-6 leading-relaxed ${plan.popular ? 'text-slate-300' : 'text-slate-600'}`}>{plan.descripcion}</p>

            <div class={`flex items-baseline gap-1 mb-8 pb-6 border-b ${plan.popular ? 'border-slate-800' : 'border-slate-100'}`}>
              <span class={`text-4xl sm:text-5xl font-black tracking-tight ${plan.popular ? 'text-white' : 'text-slate-900'}`}>{plan.precioMensual}</span>
              <span class={`font-medium text-sm ${plan.popular ? 'text-slate-400' : 'text-slate-500'}`}> MXN / mes</span>
            </div>

            <ul class="space-y-3.5 mb-8">
              {plan.caracteristicas.map((item) => (
                <li class={`flex items-start gap-3 text-sm ${plan.popular ? 'text-slate-200' : 'text-slate-700'}`}>
                  <span class={`w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5 ${
                    plan.popular ? 'bg-purple-900/80 text-purple-300 border border-purple-500/40' : 'bg-purple-100 text-purple-700 border border-purple-200'
                  }`}>
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={plan.ctaHref}
            class={`w-full py-3.5 px-6 rounded-xl font-extrabold text-center text-sm transition-all duration-300 ${
              plan.popular
                ? 'bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-600/30 hover:-translate-y-0.5'
                : 'bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 hover:border-purple-300'
            }`}
          >
            {plan.ctaText}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>