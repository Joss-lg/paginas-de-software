---
---
<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la sección -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Disponible en todo dispositivo</h2>
      <p class="text-slate-600 max-w-2xl mx-auto text-lg leading-relaxed">
        El sistema opera mediante una infraestructura en la nube, lo que facilita el acceso a la información de la empresa desde distintos equipos. Esto permite a la gerencia y al personal consultar inventarios, registrar órdenes y administrar las sucursales utilizando computadoras de escritorio o dispositivos portátiles de manera fluida.
      </p>
    </div>

    <!-- Contenedor de visualización (Mockups con alusión a dispositivos) -->
    <div class="relative flex justify-center items-center max-w-5xl mx-auto mt-12 pb-16">
      
      <!-- Placeholder Computadora (Monitor) -->
      <div class="relative w-full md:w-4/5 aspect-[16/9] bg-slate-50 border-[6px] border-slate-300 rounded-lg flex flex-col items-center justify-center p-8 shadow-sm">
        <svg class="w-12 h-12 text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span class="text-slate-400 font-medium text-sm text-center">Espacio para Imagen: <br/>Vista del sistema en monitor</span>
        
        <!-- Alusión a base de monitor -->
        <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-24 h-4 bg-slate-300 rounded-b-md"></div>
        <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-40 h-2 bg-slate-400 rounded-t-lg"></div>
      </div>

      <!-- Placeholder Celular (Móvil) -->
      <div class="absolute -bottom-4 md:bottom-[-2rem] right-4 md:right-12 w-2/5 md:w-1/5 aspect-[9/16] bg-slate-100 border-4 border-slate-400 rounded-3xl flex flex-col items-center justify-center p-4 shadow-xl backdrop-blur-sm">
        
        <!-- Alusión a notch de teléfono -->
        <div class="absolute top-2 left-1/2 -translate-x-1/2 w-16 h-3 bg-slate-300 rounded-full"></div>
        
        <svg class="w-8 h-8 text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        <span class="text-slate-500 font-medium text-xs text-center">
          Vista en móvil
        </span>
      </div>

    </div>
  </div>
</section>