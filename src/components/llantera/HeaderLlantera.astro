<script>
  // --- Sistema de partículas sincronizado con la animación CSS de la llanta ---
  // IMPORTANTE: DURATION debe coincidir siempre con el "7s" del keyframe tire-movement.
  const DURATION = 7000;

  // Instantes de rebote leídos directamente de tire-movement (en % del ciclo -> ms)
  const BOUNCE_TIMES = [0.10, 0.20, 0.25, 0.28].map((p) => p * DURATION);

  function setupTireParticles() {
    const stage = document.getElementById('tireStage');
    const wrapper = document.getElementById('tireWrapper');
    const impactLayer = document.getElementById('impactParticles');
    const smokeLayer = document.getElementById('smokeParticles');

    if (!stage || !wrapper || !impactLayer || !smokeLayer) return;

    let timers = [];
    let smokeIntervalId = null;

    function clearTimers() {
      timers.forEach((id) => clearTimeout(id));
      timers = [];
      if (smokeIntervalId) {
        clearInterval(smokeIntervalId);
        smokeIntervalId = null;
      }
    }

    function spawnImpactBurst() {
      const stageRect = stage.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();

      // Centro de la llanta y su radio real (el caucho ocupa r=90 de un viewBox de 200,
      // es decir, el 45% del ancho renderizado del SVG)
      const centerX = wrapperRect.left - stageRect.left + wrapperRect.width / 2;
      const centerY = wrapperRect.top - stageRect.top + wrapperRect.height / 2;
      const radius = wrapperRect.width * 0.45;
      const count = 8;

      for (let i = 0; i < count; i++) {
        const p = document.createElement('span');
        p.className = 'particle impact-p';

        // Arco inferior de la llanta (zona de contacto con el piso, donde va "rodando")
        // 90° = abajo. Se reparte entre 55° y 125° para cubrir el borde inferior completo.
        const angle = ((55 + Math.random() * 70) * Math.PI) / 180;
        const originX = centerX + Math.cos(angle) * radius;
        const originY = centerY + Math.sin(angle) * radius;

        const dist = 26 + Math.random() * 28;
        const dx = Math.cos(angle) * dist;
        const dy = Math.abs(Math.sin(angle) * dist) * 0.7 + 8;
        const size = 6 + Math.random() * 6;

        p.style.left = `${originX}px`;
        p.style.top = `${originY}px`;
        p.style.width = `${size}px`;
        p.style.height = `${size}px`;
        p.style.background = Math.random() > 0.5 ? '#cbd5e1' : '#94a3b8';
        p.style.setProperty('--dx', `${dx}px`);
        p.style.setProperty('--dy', `${dy}px`);

        p.addEventListener('animationend', () => p.remove());
        impactLayer.appendChild(p);
      }
    }

    function spawnSmokePuff() {
      const stageRect = stage.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();

      // Centro y radio real de la llanta
      const centerX = wrapperRect.left - stageRect.left + wrapperRect.width / 2;
      const centerY = wrapperRect.top - stageRect.top + wrapperRect.height / 2;
      const radius = wrapperRect.width * 0.45;

      // Borde exterior trasero (la llanta avanza hacia la derecha, así que el humo
      // sale de la mitad izquierda del aro: entre 130° y 230°, con 180° = punto más a la izquierda)
      const angle = ((130 + Math.random() * 100) * Math.PI) / 180;
      const originX = centerX + Math.cos(angle) * radius;
      const originY = centerY + Math.sin(angle) * radius;

      const p = document.createElement('span');
      p.className = 'particle smoke-p';

      const dx = -30 - Math.random() * 40;
      const dy = -16 - Math.random() * 26;
      const size = 18 + Math.random() * 20;

      p.style.left = `${originX}px`;
      p.style.top = `${originY}px`;
      p.style.width = `${size}px`;
      p.style.height = `${size}px`;
      p.style.background = 'radial-gradient(circle, rgba(226,232,240,0.55), rgba(226,232,240,0))';
      p.style.setProperty('--dx', `${dx}px`);
      p.style.setProperty('--dy', `${dy}px`);

      p.addEventListener('animationend', () => p.remove());
      smokeLayer.appendChild(p);
    }

    function scheduleCycle() {
      clearTimers();

      // Ráfagas de impacto en cada rebote
      BOUNCE_TIMES.forEach((t) => {
        timers.push(setTimeout(spawnImpactBurst, t));
      });

      // Humo: arranca cuando termina el rebote (30%) y cubre la desaceleración/aceleración en X
      timers.push(
        setTimeout(() => {
          smokeIntervalId = setInterval(spawnSmokePuff, 55);
        }, 0.30 * DURATION)
      );

      // Detiene el spawn de humo un poco antes de que termine el ciclo para que no queden restos
      timers.push(
        setTimeout(() => {
          if (smokeIntervalId) {
            clearInterval(smokeIntervalId);
            smokeIntervalId = null;
          }
        }, DURATION - 100)
      );
    }

    scheduleCycle();
    wrapper.addEventListener('animationiteration', scheduleCycle);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTireParticles);
  } else {
    setupTireParticles();
  }
</script>