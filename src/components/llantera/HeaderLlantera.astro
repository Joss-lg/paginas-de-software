<style>
  /* Animación de la llanta (Caída, rebotes, deformación y salida) */
  @keyframes tire-movement {
    0% { transform: translateY(-400px) scaleY(1.2) scaleX(0.8); }
    10% { transform: translateY(0) scaleX(1.15) scaleY(0.85); }
    15% { transform: translateY(-80px) scale(1); }
    20% { transform: translateY(0) scaleX(1.08) scaleY(0.92); }
    25% { transform: translateY(-30px) scale(1); }
    28% { transform: translateY(0) scaleX(1.02) scaleY(0.98); }
    30% { transform: translateY(0) scale(1); }
    40% { transform: translateX(0); }
    50% { transform: translateX(-40px); }
    100% { transform: translateX(800px); }
  }

  /* Animación de giro de los trapecios (solo después de los rebotes) */
  @keyframes holes-spin {
    0%, 30% { transform: rotate(0deg); }
    100% { transform: rotate(1440deg); }
  }

  .animate-tire {
    animation: tire-movement 7s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  .animate-holes {
    animation: holes-spin 7s linear infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
</style>

<!--
  is:global es OBLIGATORIO aquí: los <span> de las partículas los crea el
  JavaScript en runtime (document.createElement), y el CSS "scoped" normal de
  Astro solo se aplica a elementos que existen en el HTML compilado del
  componente. Si esto fuera un <style> normal, estas reglas nunca
  coincidirían con las partículas y no se verían.
-->
<style is:global>
  #tireStage {
    position: relative;
    overflow: visible;
  }

  #impactParticles,
  #smokeParticles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 20;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    will-change: transform, opacity;
  }

  @keyframes impact-particle {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.2);
    }
  }

  @keyframes smoke-particle {
    0% {
      opacity: 0.55;
      transform: translate(0, 0) scale(0.5);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(2.2);
    }
  }

  .impact-p {
    animation: impact-particle 480ms ease-out forwards;
  }

  .smoke-p {
    animation: smoke-particle 900ms ease-out forwards;
    filter: blur(1px);
  }
</style>

