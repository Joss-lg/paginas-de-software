              <path fill="#3f3f46" transform="rotate(60, 100, 100)" d="M92 75 L108 75 L116 44 A 2 2 0 0 0 114 42 L86 42 A 2 2 0 0 0 84 44 Z" />
              <path fill="#3f3f46" transform="rotate(120, 100, 100)" d="M92 75 L108 75 L116 44 A 2 2 0 0 0 114 42 L86 42 A 2 2 0 0 0 84 44 Z" />
              <path fill="#3f3f46" transform="rotate(180, 100, 100)" d="M92 75 L108 75 L116 44 A 2 2 0 0 0 114 42 L86 42 A 2 2 0 0 0 84 44 Z" />
              <path fill="#3f3f46" transform="rotate(240, 100, 100)" d="M92 75 L108 75 L116 44 A 2 2 0 0 0 114 42 L86 42 A 2 2 0 0 0 84 44 Z" />
              <path fill="#3f3f46" transform="rotate(300, 100, 100)" d="M92 75 L108 75 L116 44 A 2 2 0 0 0 114 42 L86 42 A 2 2 0 0 0 84 44 Z" />
