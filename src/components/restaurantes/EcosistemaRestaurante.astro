---
---
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-16">
      Cada herramienta en el dispositivo correcto:
    </h2>

    <div class="grid md:grid-cols-3 gap-12">
      <!-- Device 1: Tablet / Móvil (Meseros) -->
      <div class="flex flex-col items-center text-center">
        <div class="h-48 flex items-end justify-center mb-8">
          <div class="w-32 h-44 bg-gray-900 rounded-xl border-4 border-gray-800 shadow-xl relative overflow-hidden">
             <div class="absolute inset-0 bg-white m-1 rounded-lg border border-gray-200 flex flex-col">
               <div class="h-6 bg-orange-500 w-full"></div>
               <div class="flex-1 grid grid-cols-2 gap-1 p-2">
                 <div class="bg-gray-100 rounded"></div><div class="bg-gray-100 rounded"></div>
                 <div class="bg-gray-100 rounded"></div><div class="bg-gray-100 rounded"></div>
               </div>
             </div>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Comandas Móviles</h3>
        <p class="text-gray-600 text-sm px-4">
          Toma notas y pedidos directamente desde la mesa de los comensales con smartphones o tablets.
        </p>
      </div>

      <!-- Device 2: Laptop/Desktop (Caja) -->
      <div class="flex flex-col items-center text-center">
        <div class="h-48 flex items-end justify-center mb-8">
          <div class="w-48 h-32 bg-gray-800 rounded-t-xl border-4 border-gray-800 shadow-xl relative overflow-hidden flex flex-col justify-end">
             <div class="absolute inset-0 bg-white m-1 rounded-t-lg border border-gray-200">
               <div class="h-4 bg-gray-100 w-full border-b border-gray-200"></div>
               <div class="p-2 grid grid-cols-3 gap-1"><div class="h-8 bg-blue-100 rounded"></div><div class="h-8 bg-green-100 rounded"></div><div class="h-8 bg-orange-100 rounded"></div></div>
             </div>
             <div class="h-2 w-56 bg-gray-900 rounded-b-xl -ml-4 relative z-10"></div>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Estación Principal (POS)</h3>
        <p class="text-gray-600 text-sm px-4">
          Control total de la caja, cobros rápidos, asignación de mesas y supervisión general.
        </p>
      </div>

      <!-- Device 3: Landscape (Cocina KDS) -->
      <div class="flex flex-col items-center text-center">
        <div class="h-48 flex items-end justify-center mb-8">
          <div class="w-44 h-32 bg-gray-900 rounded-xl border-4 border-gray-800 shadow-xl relative overflow-hidden">
             <div class="absolute inset-0 bg-white m-1 rounded-lg border border-gray-200 flex space-x-2 p-2">
               <div class="flex-1 bg-yellow-50 rounded border border-yellow-200"></div>
               <div class="flex-1 bg-green-50 rounded border border-green-200"></div>
             </div>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Pantalla de Cocina (KDS)</h3>
        <p class="text-gray-600 text-sm px-4">
          Visualiza los platillos pendientes ordenados por tiempo de preparación y prioridad.
        </p>
      </div>
    </div>
  </div>
</section>