---
// src/components/restaurantes/EcosistemaRestaurante.astro
interface Props {
  dashboardImage?: string;
}

const { dashboardImage = "/restaurante/dahsword.webp" } = Astro.props;
---
<section class="py-20 bg-slate-950 text-white border-t border-slate-900/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-5xl mx-auto space-y-12">
      
      <!-- Encabezado -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold text-orange-400 uppercase tracking-widest bg-orange-500/10 border border-orange-500/20 px-3.5 py-1 rounded-full inline-block">
          Flujo Operativo
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Sincronización Total 
        </h2>
        <p class="text-slate-400 text-base">
          Diseñado para eliminar confusiones en pedidos y mantener el control exacto de cada mesa.
        </p>
      </div>

      <!-- 1. IMAGEN EN GRANDE DE LA CONSOLA (Arriba) -->
      <div class="relative rounded-3xl bg-slate-900/90 p-3 sm:p-4 border border-slate-800 shadow-2xl hover:border-orange-500/40 transition-all duration-500 group">
        
        <!-- Resplandor reactivo -->
        <div class="absolute -inset-0.5 bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>

        <div class="flex items-center justify-between border-b border-slate-800/80 pb-3 px-3">
          <div>
            <h3 class="text-sm font-bold text-white group-hover:text-orange-400 transition-colors">Consola Central del Sistema</h3>
            <p class="text-xs text-slate-400">Atención en mesas & permisos de personal</p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-medium border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Sincronizado
          </span>
        </div>

        <div class="relative rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 aspect-[16/8] mt-3">
          <img 
            src={dashboardImage} 
            alt="Dashboard principal del sistema de restaurantes" 
            loading="lazy"
            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
          />
        </div>
      </div>

    </div>

  </div>
</section>