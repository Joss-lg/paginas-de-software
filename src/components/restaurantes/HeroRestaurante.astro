---
// src/components/restaurantes/HeroRestaurante.astro
interface Props {
  heroImage?: string;
  imageAlt?: string;
}

const { 
  heroImage = "/public/restaurante/restaurante-hero-mockup.webp", 
  imageAlt = "Vista del sistema de comandas en tablet vertical" 
} = Astro.props;
---
<section class="relative overflow-hidden bg-slate-950 py-20 lg:py-28 text-white">
  <!-- Efectos de luz de fondo -->
  <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-orange-600/20 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 h-96 w-96 rounded-full bg-amber-500/20 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Contenido de Texto -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-400 text-xs font-semibold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          Sistema de Comandas y Mesas para Restaurantes
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Agiliza la toma de comandas y el control de mesas en tu <span class="bg-gradient-to-r from-orange-400 via-amber-400 to-yellow-500 bg-clip-text text-transparent">restaurante</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed">
          Diseñado para el flujo dinámico de meseros y cocina. Levanta comandas al instante desde cualquier Dispositivo.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a href="#planes" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-center transition-all shadow-lg shadow-orange-600/30 hover:scale-[1.02]">
            Ver Planes para Restaurante
          </a>
          <a href="#contacto" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-center transition-all">
            Solicitar Demo
          </a>
        </div>

        <div class="pt-6 border-t border-slate-800 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <p class="text-2xl font-bold text-white">100%</p>
            <p class="text-xs text-slate-400">Control de Mesas</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white">2x</p>
            <p class="text-xs text-slate-400">Atención más Rápida</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white">0%</p>
            <p class="text-xs text-slate-400">Comandas Perdidas</p>
          </div>
        </div>
      </div>

      <!-- Contenedor Estilizado: Tablet Vertical -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[340px] sm:max-w-[380px] bg-slate-900 border-4 border-slate-700 rounded-[36px] p-3 shadow-2xl shadow-orange-500/10">
          
          <!-- Lente / Cámara frontal superior de la tablet -->
          <div class="flex justify-center mb-2">
            <span class="w-3 h-3 rounded-full bg-slate-950 border border-slate-800"></span>
          </div>

          <!-- Pantalla de la Tablet (Vertical - Aspect Ratio 3/4) -->
          <div class="relative overflow-hidden rounded-[24px] bg-slate-950 aspect-[3/4] border border-slate-800/80">
            <img 
              src={heroImage} 
              alt={imageAlt}
              loading="eager"
              class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Barra táctil inferior estilo tablet -->
          <div class="flex justify-center mt-3">
            <span class="w-28 h-1 rounded-full bg-slate-700"></span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>