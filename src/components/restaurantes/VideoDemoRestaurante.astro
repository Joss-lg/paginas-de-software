---
// src/components/restaurantes/VideoDemoRestaurante.astro
interface Props {
  videoSrc?: string;
  posterImage?: string;
  youtubeEmbedUrl?: string;
}

const { 
  videoSrc = "/videos/demo-comandas-restaurante.mp4",
  posterImage = "/images/video-poster-preview.webp",
  youtubeEmbedUrl
} = Astro.props;
---

<section id="demo" class="py-20 bg-white text-slate-800 relative overflow-hidden border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-slate-500 animate-ping"></span>
        Demostración Interactiva
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-800 tracking-tight">
        Mira la velocidad del sistema en <span class="text-slate-600">tiempo real</span>
      </h2>
    </div>

    <div class="max-w-5xl mx-auto space-y-10">
      
      <div class="relative rounded-3xl bg-slate-800 p-3 sm:p-4 border border-slate-700 shadow-2xl group hover:border-slate-500 transition-all duration-300">
        <div class="flex items-center justify-between px-3 pb-3 border-b border-slate-700 mb-3 text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-slate-600"></span>
            <span class="w-3 h-3 rounded-full bg-slate-500"></span>
            <span class="w-3 h-3 rounded-full bg-slate-400"></span>
            <span class="font-mono text-[11px] text-slate-300 ml-2 hidden sm:inline-block">demostración_sistema_pos.mp4</span>
          </div>
          <div class="flex items-center gap-3 font-mono text-[11px]">
            <span class="px-2 py-0.5 rounded bg-slate-700 text-slate-200 border border-slate-600 font-bold">1080p HD</span>
          </div>
        </div>

        <div class="relative rounded-2xl overflow-hidden bg-slate-900 aspect-video border border-slate-700 shadow-inner">
          {youtubeEmbedUrl ? (
            <iframe 
              src={youtubeEmbedUrl} 
              title="Demostración del sistema para restaurantes"
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          ) : (
            <video 
              controls 
              preload="metadata"
              poster={posterImage}
              class="w-full h-full object-cover"
            >
              <source src={videoSrc} type="video/mp4" />
              Tu navegador no soporta la reproducción de video HTML5.
            </video>
          )}
        </div>
      </div>

      <!-- BOTÓN INFERIOR AJUSTADO A LA PALETA GRIS -->
      <div class="text-center pt-2">
        <a 
          href="#contacto" 
          class="inline-flex items-center justify-center py-4 px-8 rounded-2xl bg-slate-800 hover:bg-slate-900 text-white font-extrabold text-sm transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] border border-slate-700"
        >
          Solicitar Prueba en Vivo para tu Restaurante
        </a>
      </div>

    </div>
  </div>
</section>