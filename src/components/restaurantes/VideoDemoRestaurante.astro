---
// src/components/restaurantes/VideoDemoRestaurante.astro
interface Props {
  videoSrc?: string;
  posterImage?: string;
  youtubeEmbedUrl?: string;
}

const { 
  videoSrc = "/videos/demo-comandas-restaurante.mp4",
  posterImage = "/images/video-poster-preview.webp",
  youtubeEmbedUrl
} = Astro.props;

---

<section id="demo-video" class="py-20 bg-slate-950 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-orange-400 text-xs font-semibold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
        Demostración Interactiva
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Mira la velocidad del sistema en <span class="bg-gradient-to-r from-orange-400 via-amber-400 to-yellow-500 bg-clip-text text-transparent">tiempo real</span>
      </h2>
    </div>

    <div class="max-w-5xl mx-auto space-y-10">
      
      <!-- 1. VIDEO / REPRODUCTOR EN GRANDE (Arriba) -->
      <div class="relative rounded-3xl bg-slate-900/90 p-3 sm:p-4 border border-slate-800 shadow-2xl">
      
        

        <div class="flex items-center justify-between px-3 pb-3 border-b border-slate-800/80 mb-3 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            <span class="font-mono text-[11px] text-slate-400 ml-2 hidden sm:inline-block">demostración_sistema_pos.mp4</span>
          </div>
          <div class="flex items-center gap-3 font-mono text-[11px]">
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">1080p HD</span>
          </div>
        </div>
        <!-- Pantalla del Video (Ratio 16:9) -->
        <div class="relative rounded-2xl overflow-hidden bg-slate-950 aspect-video border border-slate-800 shadow-inner">
          {youtubeEmbedUrl ? (
            <iframe 
              src={youtubeEmbedUrl} 
              title="Demostración del sistema para restaurantes"
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          ) : (
            <video 
              controls 
              preload="metadata"
              poster={posterImage}
              class="w-full h-full object-cover"
            >
              <source src={videoSrc} type="video/mp4" />
              Tu navegador no soporta la reproducción de video HTML5.
            </video>
          )}
        </div>
      </div>
      <!-- Botón de acción centrado -->
      <div class="text-center pt-2">
        <a 
          href="#contacto" 
          class="inline-flex items-center justify-center py-4 px-8 rounded-2xl bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white font-extrabold text-sm transition-all shadow-lg shadow-orange-600/25 hover:scale-[1.02]"
        >
          Solicitar Prueba en Vivo para tu Restaurante
        </a>
      </div>
    </div>
  </div>
</section>