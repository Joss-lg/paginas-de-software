---
// src/components/restaurantes/ModulosRestaurante.astro
const planesRestaurante = [
  {
    nombre: "Plan Básico (Mostrador)",
    subtitulo: "Ideal para restaurantes pequeños con cobro en caja",
    precioMensual: "599.00",
    precioAnual: "5,990.00",
    
    destacado: false,
    caracteristicas: [
      "1 estación de cobro (Caja)",
      "Módulo POS y alta de productos/bebidas",
      "Impresión de tickets de consumo",
      "Apertura y corte de caja diario",
      "Reporte mensual de ventas"
    ]
  },
  {
    nombre: "Plan Profesional",
    subtitulo: "Ideal para Restaurantes con mesas y meseros",
    precioMensual: "999.00",
    precioAnual: "9,990.00",
   
    destacado: true,
    etiqueta: "MÁS POPULAR",
    caracteristicas: [
      "Hasta 3 estaciones (Caja + 2 Comanderas para Meseros)",
      "Gestión y asignación de mesas en mapa",
      "Levantamiento de comandas digitales a cocina",
      "Roles y permisos (Admin / Cajero / Mesero)",
      "Captura de gastos directos y reporte analítico"
    ]
  },
  {
    nombre: "Plan Premium",
    subtitulo: "Para restaurantes de alto volumen o multiservicio",
    precioMensual: "1,299.00",
    precioAnual: "12,990.00",
    
    destacado: false,
    caracteristicas: [
      "Estaciones y comanderas ilimitadas",
      "Módulo de comandas de cocina + módulo para mesas",
      "Cuentas separadas por comensal",
      "Control de propinas e inventarios",
      "Soporte técnico prioritario 24/7"
    ]
  }
];
---
<section id="planes" class="py-20 bg-white text-slate-800 relative border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3.5 py-1 text-xs font-bold rounded-full bg-slate-100 text-slate-700 border border-slate-300 uppercase tracking-widest">
        Suscripción 
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-800 mt-4">
        Planes para el Sistema de Restaurante
      </h2>
      <p class="mt-3 text-slate-600 text-base">
        Elige la capacidad requerida para tu establecimiento. Descuento de <strong class="text-slate-800">2 meses gratis en pago anual</strong>.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {planesRestaurante.map((plan) => (
        <div class={`relative rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-3 cursor-pointer group ${
          plan.destacado 
            ? 'bg-slate-950 text-white border-4 border-slate-800 shadow-2xl lg:-translate-y-2 z-10 hover:border-slate-300 hover:shadow-slate-900/40' 
            : 'bg-white border-2 border-slate-200 shadow-md hover:border-slate-700 hover:shadow-2xl hover:shadow-slate-400/30'
        }`}>
          
          {plan.destacado && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-white text-slate-950 text-xs font-black uppercase tracking-wider shadow-lg border border-slate-200">
              {plan.etiqueta}
            </div>
          )}

          <div>
            <h3 class={`text-2xl font-bold transition-colors ${plan.destacado ? 'text-white group-hover:text-slate-300' : 'text-slate-800 group-hover:text-slate-950'}`}>
              {plan.nombre}
            </h3>
            <p class={`text-xs mt-1.5 min-h-[32px] ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>
              {plan.subtitulo}
            </p>

            <!-- Caja de precio con contraste según el plan -->
            <div class={`mt-6 p-4 rounded-2xl border transition-all duration-300 ${
              plan.destacado 
                ? 'bg-slate-900 border-slate-800 group-hover:border-slate-500' 
                : 'bg-slate-50 border-slate-200 group-hover:border-slate-400'
            }`}>
              <div class="flex items-baseline gap-1">
                <span class={`text-3xl font-black ${plan.destacado ? 'text-white' : 'text-slate-800'}`}>${plan.precioMensual}</span>
                <span class={`text-xs font-medium ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>MXN / mes</span>
              </div>

              <div class={`mt-3 text-xs space-y-1.5 border-t pt-3 ${
                plan.destacado ? 'text-slate-300 border-slate-800' : 'text-slate-600 border-slate-200'
              }`}>
                <p class="flex justify-between">
                  <span class={plan.destacado ? 'text-slate-400' : 'text-slate-500'}>Pago Anual (-2 meses):</span>
                  <strong class={plan.destacado ? 'text-white' : 'text-slate-800'}>${plan.precioAnual} MXN</strong>
                </p>
                <p class="flex justify-between">
                  <span class={plan.destacado ? 'text-slate-400' : 'text-slate-500'}>3 MSI:</span>
                  <span>${plan.msi3} MXN / mes</span>
                </p>
                <p class="flex justify-between">
                  <span class={plan.destacado ? 'text-slate-400' : 'text-slate-500'}>6 MSI:</span>
                  <span>${plan.msi6} MXN / mes</span>
                </p>
              </div>
            </div>

            <!-- Lista de Características -->
            <ul class="mt-6 space-y-3">
              {plan.caracteristicas.map((item) => (
                <li class={`flex items-start gap-2.5 text-sm ${plan.destacado ? 'text-slate-300' : 'text-slate-600'}`}>
                  <svg class={`w-5 h-5 shrink-0 mt-0.5 group-hover:scale-125 transition-transform duration-300 ${plan.destacado ? 'text-white' : 'text-slate-800'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-8">
            <a 
              href="#contacto" 
              class={`block w-full py-4 px-4 rounded-xl text-center font-bold text-sm transition-all duration-300 group-hover:scale-[1.02] ${
                plan.destacado 
                  ? 'bg-white hover:bg-slate-100 text-slate-950 shadow-lg font-black' 
                  : 'bg-slate-800 hover:bg-slate-900 text-white shadow-md'
              }`}
            >
              Seleccionar Plan
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>