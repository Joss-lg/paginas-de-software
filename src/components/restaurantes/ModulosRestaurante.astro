---
// src/components/restaurantes/ModulosRestaurante.astro
const planes = [
  {
    nombre: "Plan Básico (Mostrador)",
    descripcion: "Ideal para restaurantes pequeños con cobro en caja",
    precio: "$599.00",
    destacado: false,
    caracteristicas: [
      "1 estación de cobro (Caja)",
      "Módulo POS y alta de productos/bebidas",
      "Impresión de tickets de consumo",
      "Apertura y corte de caja diario",
      "Reporte mensual de ventas"
    ]
  },
  {
    nombre: "Plan Profesional",
    descripcion: "Ideal para Restaurantes con mesas y meseros",
    precio: "$999.00",
    destacado: true,
    caracteristicas: [
      "Hasta 3 estaciones (Caja + 2 Comanderas para Meseros)",
      "Gestión y asignación de mesas en mapa",
      "Levantamiento de comandas digitales a cocina",
      "Roles y permisos (Admin / Cajero / Mesero)",
      "Captura de gastos directos y reporte analítico"
    ]
  },
  {
    nombre: "Plan Premium",
    descripcion: "Para restaurantes de alto volumen o multiservicio",
    precio: "$1,299.00",
    destacado: false,
    caracteristicas: [
      "Estaciones y comanderas ilimitadas",
      "Módulo de comandas de cocina + módulo para mesas",
      "Cuentas separadas por comensal",
      "Control de propinas e inventarios",
      "Soporte técnico prioritario 24/7"
    ]
  }
];
---

<section id="planes" class="py-20 bg-slate-50 text-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch pt-6 pb-6">
      {planes.map((plan) => (
        <div class={`relative rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:z-20 ${
          plan.destacado 
            ? 'bg-slate-950 text-white shadow-2xl scale-105 hover:scale-110 border-2 border-slate-800 hover:shadow-3xl' 
            : 'bg-white text-slate-800 border-2 border-slate-200 shadow-sm hover:scale-105 hover:shadow-xl hover:border-slate-300'
        }`}>
          
          {plan.destacado && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-white text-slate-950 text-xs font-black uppercase px-4 py-1 rounded-full shadow-md tracking-wider">
              Más Popular
            </div>
          )}

          <div>
            <h3 class="text-2xl font-bold mb-2">{plan.nombre}</h3>
            <p class={`text-sm mb-6 ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>
              {plan.descripcion}
            </p>

            <!-- Contenedor solo con el costo principal -->
            <div class={`p-5 rounded-2xl mb-8 flex items-baseline gap-2 ${
              plan.destacado ? 'bg-slate-900/80 border border-slate-800' : 'bg-slate-100 border border-slate-200'
            }`}>
              <span class="text-3xl sm:text-4xl font-extrabold tracking-tight">{plan.precio}</span>
              <span class={`text-sm font-semibold ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>MXN / mes</span>
            </div>

            <ul class="space-y-4 mb-8">
              {plan.caracteristicas.map((item) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg class={`w-5 h-5 flex-shrink-0 mt-0.5 ${plan.destacado ? 'text-white' : 'text-slate-800'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Botón de contratación -->
          <div class="pt-4">
            <a href="https://wa.me/521XXXXXXXXXX?text=Hola,%20me%20interesa%20el%20Plan%20Emprendedor#contacto" class={`w-full py-3.5 px-6 rounded-xl font-bold text-center block transition-all duration-300 shadow-md ${ plan.destacado? 'bg-white text-slate-950 hover:bg-slate-100 hover:shadow-white/20': 'bg-slate-900 text-white hover:bg-slate-800 hover:shadow-slate-900/20'}`} >
              Contrata nuestro plan
            </a>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>