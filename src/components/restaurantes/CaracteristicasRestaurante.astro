---
// src/components/restaurantes/CaracteristicasRestaurante.astro
const caracteristicas = [
  {
    titulo: "Toma de Comandas en Mesas",
    descripcion: "Facilita el registro de los pedidos directamente con los comensales mediante dispositivos destinados para esta tarea, organizando la atención.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
      </svg>
    `,
    imagen: "/restaurante/comanda.webp"
  },
  {
    titulo: "Registro de Menú y Productos",
    descripcion: "Permite agregar nuevos artículos y organizarlos por categorías para mantener la oferta del establecimiento actualizada en todo momento.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
    `,
    imagen: "/restaurante/menu.webp"
  },
  {
    titulo: "Control de Personal",
    descripcion: "Establece accesos específicos mediante roles definidos. Asigna permisos diferenciados de forma clara para el cajero, el mesero y el administrador.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
      </svg>
    `,
    imagen: "/restaurante/role.webp"
  },
  {
    titulo: "Gestión de Caja y Tickets",
    descripcion: "Coordina las estaciones de cobro, controla la apertura de las cajas y emite los tickets correspondientes al consumo de cada visita.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5pt1.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
      </svg>
    `,
    imagen: "/restaurante/cobros.webp"
  },
  {
    titulo: "Envíos a Domicilio",
    descripcion: "Administra los pedidos orientados al reparto fuera del establecimiento y cuenta con herramientas para integrar un registro de clientes.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
      </svg>
    `,
    imagen: "/restaurante/mesa.webp"
  },
  {
    titulo: "Reportes de Ventas y Gastos",
    descripcion: "Genera resúmenes precisos sobre las ventas obtenidas de manera diaria y mensual, incluyendo el registro de los gastos del negocio.",
    iconoSvg: `
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
      </svg>
    `,
    imagen: "/restaurante/reportes.webp"
  }
];
---
<section class="py-24 bg-white text-slate-800 font-sans">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-6">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-500">
        Administración Formal y Estructurada
      </h2>
      <p class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Control Operativo para Restaurantes
      </p>
      <p class="text-slate-500 text-lg sm:text-xl font-normal leading-relaxed">
        Soluciones diseñadas para organizar el trabajo diario, desde la atención en las mesas hasta el control financiero de los ingresos y las responsabilidades del personal.
      </p>
    </div>

    <!-- Contenedor general en columna con separación amplia -->
    <div class="flex flex-col gap-16 lg:gap-24">
      {caracteristicas.map((item, index) => (
        <div class={`flex flex-col lg:flex-row items-center gap-8 lg:gap-12 ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
          
          <!-- Bloque de Texto (Tarjeta Independiente con Animación) -->
          <div class="w-full lg:w-1/2 bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200/80 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1.5 hover:shadow-2xl group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center mb-6 group-hover:bg-slate-900 group-hover:text-white transition-colors duration-300">
                <span class="inline-flex items-center justify-center" set:html={item.iconoSvg} />
              </div>

              <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4 leading-snug">
                {item.titulo}
              </h3>
              
              <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-normal">
                {item.descripcion}
              </p>
            </div>
          </div>

          <!-- Bloque de la Imagen (Sin tarjeta contenedora, con su animación propia intacta) -->
          <div class="w-full lg:w-1/2 flex justify-center">
            <div class="w-full rounded-3xl overflow-hidden bg-slate-900 border border-slate-800 shadow-2xl transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1.5 hover:-rotate-2 hover:shadow-2xl">
              
              <!-- Barra superior del navegador -->
              <div class="bg-slate-800 px-4 py-2.5 flex items-center gap-2 border-b border-slate-700">
                <!-- Botones de acción (Estilo macOS) -->
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <!-- Barras decorativas simulando contenido estructural -->
                <div class="ml-4 flex items-center gap-2">
                  <div class="w-24 sm:w-32 h-4 bg-white/10 rounded-md"></div>
                  <div class="w-12 h-4 bg-white/5 rounded-md hidden sm:block"></div>
                </div>
              </div>

              <!-- Área de la imagen -->
              <div class="p-2 sm:p-3 bg-slate-900 flex justify-center">
                <img 
                  src={item.imagen} 
                  alt={item.titulo} 
                  loading="lazy"
                  class="w-full h-auto object-contain rounded-lg shadow-sm"
                />
              </div>

            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>