---
// src/components/restaurantes/CaracteristicasRestaurante.astro
const caracteristicas = [
  {
    titulo: "Levantamiento de Comandas Digitales",
    descripcion: "Toma de pedidos en mesa desde smartphones o tablets que envían las órdenes directamente a la impresora o pantalla de cocina.",
    icono: "📝",
    imagen: "/restaurante/comanda.webp"
  },
  {
    titulo: "Administración y Mapa de Mesas",
    descripcion: "Visualiza rápidamente qué mesas están disponibles, ocupadas, en espera de comida o listas para pedir la cuenta.",
    icono: "🪑",
    imagen: "/restaurante/mesa.webp"
  },
  {
    titulo: "Control de Roles y Permisos",
    descripcion: "Configura accesos específicos para meseros, cajeros, capitán de meseros y administradores del restaurante.",
    icono: "👥",
    imagen: "/restaurante/role.webp"
  },
  {
    titulo: "Cobro y División de Cuentas",
    descripcion: "Soporta cobros parciales, cuentas separadas por comensal y múltiples formas de pago.",
    icono: "💳",
    imagen: "/restaurante/cobros.webp"
  },
  {
    titulo: "Gestión de Menú y Productos",
    descripcion: "Agrega, modifica o deshabilita platillos, bebidas y modificadores (sin cebolla, término medio, extras) en tiempo real.",
    icono: "🍽️",
    imagen: "/restaurante/menu.webp"
  },
  {
    titulo: "Reportes Diarios y Mensuales",
    descripcion: "Obtén el cierre de caja exacto, ventas por mesero, platos más vendidos y registro de consumo total del día.",
    icono: "📊",
    imagen: "/restaurante/reportes.webp"
  }
];
---
<section class="py-20 bg-slate-950 text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <h2 class="text-xs font-bold uppercase tracking-widest text-orange-400 bg-orange-500/10 border border-orange-500/20 px-3.5 py-1 rounded-full inline-block">
        Diseñado para un mejor control
      </h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Funcionalidades Diseñadas para tu Restaurante
      </p>
      <p class="text-slate-400 text-base sm:text-lg">
        Conoce los módulos visuales creados para agilizar el servicio al cliente.
      </p>
    </div>

    <!-- Grid de Tarjetas con Imagen Grande Arriba -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {caracteristicas.map((item) => (
        <div class="rounded-3xl bg-slate-900/80 border border-slate-800/90 overflow-hidden hover:border-orange-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-orange-500/10 flex flex-col group backdrop-blur-sm">
          
          <!-- 1. IMAGEN EN GRANDE (ARRIBA) -->
          <div class="p-3 pb-0">
            <div class="relative rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 aspect-[16/8]">
              <img 
                src={item.imagen} 
                alt={item.titulo} 
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-108 transition-transform duration-700 ease-out"
              />
              <!-- Overay suave en hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
          </div>

          <!-- 2. ICONO, TÍTULO Y DESCRIPCIÓN (ABAJO) -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-start">
            <div class="w-12 h-12 rounded-2xl bg-slate-800/90 border border-slate-700/60 flex items-center justify-center text-xl mb-4 group-hover:scale-110 group-hover:bg-orange-500/20 group-hover:border-orange-500/40 transition-all duration-300">
              <span class="group-hover:rotate-12 transition-transform duration-300 inline-block">{item.icono}</span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2.5 leading-snug group-hover:text-orange-400 transition-colors duration-300">{item.titulo}</h3>
            <p class="text-slate-400 text-sm leading-relaxed font-normal">{item.descripcion}</p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>