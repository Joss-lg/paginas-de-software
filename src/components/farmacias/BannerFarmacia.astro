---
// Definimos las propiedades que puede recibir este componente
interface Props {
  image: string;
  alt: string;
  customClass?: string; // Hacemos la clase opcional para controlar márgenes
}

const { image, alt, customClass = "" } = Astro.props;
---

<div class={`relative w-full z-20 ${customClass}`}>
  <div class="relative w-full h-48 lg:h-64 overflow-hidden shadow-2xl border-y-4 border-[#046852]">
    
    <img 
      src={image} 
      alt={alt} 
      class="absolute inset-0 w-full h-full object-cover object-center scale-105 transform hover:scale-110 transition-transform duration-[2s] ease-out"
    />
    
    <div class="absolute inset-0 bg-black/30"></div>

    <div class="absolute inset-0 flex items-center justify-center">
      <h2 class="text-3xl md:text-5xl font-extrabold text-white text-center px-4 tracking-tight drop-shadow-2xl italic">
        <slot />
      </h2>
    </div>
  </div>

  <div class="absolute -bottom-1 left-0 w-full h-4 bg-gradient-to-t from-[#046852] to-transparent"></div>
</div>