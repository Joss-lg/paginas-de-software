---
// src/components/farmacias/FarmaciaPlanes.astro
const planes = [
  {
    name: "nuestro plan",
    price: "$499",
    period: "MXN / mes",
    description: "Perfecto para farmacias independientes de mostrador único.",
    features: [
      "1 Caja de cobro",
      "Inventario hasta 5,000 productos",
      "Control de caducidades básico",
      "Corte de caja diario"
    ],
    highlight: false
  },
  {
    name: "nuestro plan",
    price: "$899",
    period: "MXN / mes",
    description: "Ideal para farmacias con consultorio y alto flujo.",
    features: [
      "Hasta 3 Cajas de cobro",
      "Productos ilimitados",
      "Módulo de médicos y antibióticos",
      "Búsqueda por sustancia activa",
      "Soporte prioritario"
    ],
    highlight: true
  },
  {
    name: "nuestro plan",
    price: "$1,499",
    period: "MXN / mes",
    description: "Para cadenas de farmacias con múltiples sucursales.",
    features: [
      "Sucursales ilimitadas",
      "Traspaso de inventario",
      "Reportes consolidados en la nube",
      "Facturación electrónica masiva",
      "API de integración"
    ],
    highlight: false
  }
];
---

<section class="py-24 bg-[#E5F3F2] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div id="planes" class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#006C5B] mb-4">
        Planes para tu negocio
      </h2>
      <p class="text-[#006C5B]/70">
        Escala tu sistema conforme crece tu farmacia. Sin plazos forzosos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
      {planes.map((plan) => (
        <div class={`relative rounded-3xl p-8 transition-all duration-300 transform hover:scale-105 cursor-pointer ${
          plan.highlight 
            ? 'bg-[#006C5B] text-white shadow-2xl shadow-[#006C5B]/40 lg:-translate-y-4 border-none' 
            : 'bg-white text-[#006C5B] border border-[#7CC6C1]/30 hover:border-[#29A09B]'
        }`}>
          
          {plan.highlight && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-[#7CC6C1] text-[#006C5B] text-xs font-black uppercase tracking-widest shadow-md">
              Más Recomendado
            </div>
          )}

          <div class="mb-8">
            <h3 class={`text-2xl font-bold mb-2 ${plan.highlight ? 'text-white' : 'text-[#006C5B]'}`}>
              {plan.name}
            </h3>
            <p class={`text-sm h-10 ${plan.highlight ? 'text-[#E5F3F2]' : 'text-[#006C5B]/60'}`}>
              {plan.description}
            </p>
          </div>
          
          <div class="flex items-baseline gap-2 mb-8 border-b pb-8 border-opacity-20 border-current">
            <span class="text-5xl font-black">{plan.price}</span>
            <span class={`text-sm font-medium ${plan.highlight ? 'text-[#7CC6C1]' : 'text-[#29A09B]'}`}>
              {plan.period}
            </span>
          </div>

          <ul class="space-y-4 mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3">
                <svg class={`w-5 h-5 shrink-0 mt-0.5 ${plan.highlight ? 'text-[#7CC6C1]' : 'text-[#29A09B]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class={`text-sm ${plan.highlight ? 'text-white/90' : 'text-[#006C5B]/80'}`}>
                  {feature}
                </span>
              </li>
            ))}
          </ul>

          <button class={`w-full py-4 rounded-xl font-bold text-center transition-all duration-300 ${
            plan.highlight
              ? 'bg-[#E5F3F2] text-[#006C5B] hover:bg-white hover:scale-105'
              : 'bg-[#E5F3F2] text-[#006C5B] hover:bg-[#29A09B] hover:text-white'
          }`}>
            Contrata {plan.name}
          </button>
        </div>
      ))}
    </div>

  </div>
</section>