---
// src/components/farmacias/FarmaciaFeatures.astro

const features = [
  {
    title: "Control de Lotes y Caducidades",
    description: "Recibe notificaciones automáticas antes de que tus medicamentos expiren. Sistema PEPS integrado para evitar mermas.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  },
  {
    title: "Búsqueda por Sustancia Activa",
    description: "Encuentra alternativas rápidamente si no tienes la marca comercial. Mejora tus ventas y no dejes ir a ningún paciente.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>`
  },
  {
    title: "Recetas y Antibióticos",
    description: "Módulo especial para el registro de médicos, folios de recetas y control estricto de venta de antibióticos y psicotrópicos.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`
  },
  {
    title: "Ventas a Granel y Fraccionadas",
    description: "Configura la venta por caja completa o por pastilla/blíster, el sistema descontará el inventario con precisión milimétrica.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>`
  },
  {
    title: "Facturación Electrónica",
    description: "Genera facturas al instante o permite que tus clientes se autofacturen desde un portal dedicado usando su ticket.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>`
  },
  {
    title: "Reportes y Cortes de Caja",
    description: "Audita turnos, revisa ganancias diarias y detecta anomalías en tiempo real desde el panel administrativo en la nube.",
    svg: `<svg class="w-6 h-6 text-[#29A09B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`
  }
];
---

<section class="py-24 bg-white relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#E5F3F2]/50 via-white to-white pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-[#29A09B]">Especializado en Salud</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-[#006C5B] tracking-tight">
        Herramientas diseñadas para el sector farmacéutico
      </p>
    </div>

    <div class="relative w-full max-w-5xl mx-auto h-[550px] sm:h-[600px] flex items-center justify-center [perspective:1200px]">
      
      <button id="prevBtn" class="absolute left-2 sm:left-10 z-40 w-12 h-12 flex items-center justify-center rounded-full bg-white border border-[#7CC6C1]/50 text-[#006C5B] shadow-lg hover:bg-[#29A09B] hover:text-white hover:scale-110 transition-all duration-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <div id="slider-container" class="relative w-full max-w-sm sm:max-w-md h-full flex justify-center items-center">
        {features.map((feature, index) => (
          <div 
            class="feature-card absolute w-full h-[520px] sm:h-[560px] bg-white rounded-3xl shadow-2xl shadow-[#006C5B]/20 border border-[#7CC6C1]/30 flex flex-col p-6 sm:p-8 justify-between overflow-hidden transition-all duration-700 ease-[cubic-bezier(0.25,0.8,0.25,1)]"
            data-index={index}
          >
            <!-- Cabecera con Icono y Título -->
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 bg-[#E5F3F2] rounded-xl flex items-center justify-center shadow-sm border border-[#7CC6C1]/30 flex-shrink-0" set:html={feature.svg} />
              <h3 class="text-xl sm:text-2xl font-bold text-[#006C5B] leading-tight">
                {feature.title}
              </h3>
            </div>

            <!-- Espacio reservado (Placeholder) donde antes iba la imagen -->
            <div class="w-full h-44 sm:h-48 rounded-2xl bg-[#E5F3F2]/60 border-2 border-dashed border-[#7CC6C1]/60 flex flex-col items-center justify-center text-center p-4 my-2">
              <svg class="w-8 h-8 text-[#29A09B] mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-xs font-bold text-[#006C5B]">Espacio para captura del sistema</span>
              <span class="text-[11px] text-[#006C5B]/60 mt-0.5">Próximamente interfaz</span>
            </div>

            <!-- Descripción en la parte inferior -->
            <p class="text-sm sm:text-base text-[#006C5B]/75 leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))}
      </div>

      <button id="nextBtn" class="absolute right-2 sm:right-10 z-40 w-12 h-12 flex items-center justify-center rounded-full bg-white border border-[#7CC6C1]/50 text-[#006C5B] shadow-lg hover:bg-[#29A09B] hover:text-white hover:scale-110 transition-all duration-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
      </button>

    </div>

    <div class="flex justify-center gap-2 mt-8" id="dots-container">
      {features.map((_, index) => (
        <button class="dot-indicator w-3 h-3 rounded-full transition-all duration-300 bg-[#7CC6C1]/40 hover:bg-[#29A09B]" data-index={index}></button>
      ))}
    </div>

  </div>
</section>

<script>
  function initSlider() {
    const cards = document.querySelectorAll('.feature-card') as NodeListOf<HTMLElement>;
    const dots = document.querySelectorAll('.dot-indicator') as NodeListOf<HTMLElement>;
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    if (!cards.length) return;

    let activeIndex = 0;
    const totalCards = cards.length;

    function updateSlider() {
      const isMobile = window.innerWidth < 640; 
      const xOffset = isMobile ? 65 : 75;

      cards.forEach((card, index) => {
        let diff = index - activeIndex;

        card.style.transform = '';
        card.style.zIndex = '';
        card.style.opacity = '';
        card.style.pointerEvents = 'none';

        if (diff === 0) {
          card.style.transform = 'translateX(0) scale(1) rotateY(0deg)';
          card.style.zIndex = '30';
          card.style.opacity = '1';
          card.style.pointerEvents = 'auto';
        } 
        else if (diff === 1 || (activeIndex === totalCards - 1 && index === 0)) {
          card.style.transform = `translateX(${xOffset}%) scale(0.85) rotateY(-15deg)`;
          card.style.zIndex = '20';
          card.style.opacity = '0.6';
          card.style.cursor = 'pointer';
          card.style.pointerEvents = 'auto';
        } 
        else if (diff === -1 || (activeIndex === 0 && index === totalCards - 1)) {
          card.style.transform = `translateX(-${xOffset}%) scale(0.85) rotateY(15deg)`;
          card.style.zIndex = '20';
          card.style.opacity = '0.6';
          card.style.cursor = 'pointer';
          card.style.pointerEvents = 'auto';
        } 
        else {
          const direction = diff > 0 ? 1 : -1;
          card.style.transform = `translateX(${direction * (xOffset + 40)}%) scale(0.7) rotateY(${direction * -25}deg)`;
          card.style.zIndex = '10';
          card.style.opacity = '0';
        }
      });

      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('bg-[#7CC6C1]/40');
          dot.classList.add('bg-[#006C5B]', 'scale-125');
        } else {
          dot.classList.add('bg-[#7CC6C1]/40');
          dot.classList.remove('bg-[#006C5B]', 'scale-125');
        }
      });
    }

    function goNext() {
      activeIndex = (activeIndex + 1) % totalCards;
      updateSlider();
    }

    function goPrev() {
      activeIndex = (activeIndex - 1 + totalCards) % totalCards;
      updateSlider();
    }

    nextBtn?.addEventListener('click', goNext);
    prevBtn?.addEventListener('click', goPrev);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        activeIndex = index;
        updateSlider();
      });
    });

    cards.forEach((card, index) => {
      card.addEventListener('click', () => {
        if (index !== activeIndex) {
          activeIndex = index;
          updateSlider();
        }
      });
    });

    window.addEventListener('resize', updateSlider);
    updateSlider();
  }

  document.addEventListener('DOMContentLoaded', initSlider);
  document.addEventListener('astro:page-load', initSlider);
</script>