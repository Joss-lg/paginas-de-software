---
// src/components/farmacias/FarmaciaHero.astro
---

<section class="relative min-h-[85vh] flex items-center pt-16 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden bg-[#E5F3F2]">
  <!-- Elementos de fondo dinámicos -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-[#7CC6C1]/30 to-transparent rounded-bl-full pointer-events-none -z-10"></div>
  <div class="absolute bottom-20 left-10 w-[300px] h-[300px] bg-[#29A09B]/15 blur-[100px] rounded-full pointer-events-none -z-10 animate-pulse"></div>

  <!-- Pastillas decorativas de fondo flotantes -->
  <div class="absolute top-[10%] left-[6%] w-9 h-4 rounded-full bg-[#7CC6C1]/50 border border-white/30 rotate-[20deg] animate-[floatA_5s_ease-in-out_infinite] pointer-events-none"></div>
  <div class="absolute top-[20%] left-[25%] w-7 h-3 rounded-full bg-[#29A09B]/40 border border-white/20 -rotate-[10deg] animate-[floatB_6.5s_ease-in-out_infinite] [animation-delay:0.8s] pointer-events-none"></div>
  <div class="absolute top-[75%] left-[10%] w-9 h-4 rounded-full bg-[#29A09B]/45 border border-white/20 rotate-[12deg] animate-[floatB_6.5s_ease-in-out_infinite] [animation-delay:1.1s] pointer-events-none"></div>
  <div class="absolute top-[15%] right-[8%] w-8 h-3.5 rounded-full bg-[#29A09B]/40 border border-white/20 rotate-[15deg] animate-[floatA_5s_ease-in-out_infinite] [animation-delay:1.9s] pointer-events-none"></div>
  <div class="absolute top-[70%] right-[12%] w-10 h-4.5 rounded-full bg-[#7CC6C1]/45 border border-white/20 -rotate-[12deg] animate-[floatB_6.5s_ease-in-out_infinite] [animation-delay:0.2s] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">

    <!-- Contenido de Texto -->
    <div class="space-y-8 text-center lg:text-left z-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#006C5B]/10 border border-[#006C5B]/20 text-[#006C5B] text-xs font-bold tracking-widest uppercase">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#29A09B] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-[#29A09B]"></span>
        </span>
        Gestión Médica Inteligente
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#006C5B] tracking-tight leading-tight">
        El control total de tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#29A09B] to-[#7CC6C1]">Farmacia</span> en un solo clic
      </h1>

      <p class="text-lg text-[#006C5B]/80 max-w-xl mx-auto lg:mx-0">
        Evita pérdidas por caducidad, agiliza las ventas con búsqueda por sustancia activa y mantén tu inventario sincronizado en todas tus sucursales.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
        <button class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#006C5B] text-white font-bold shadow-lg shadow-[#006C5B]/30 hover:bg-[#29A09B] hover:-translate-y-1 transition-all duration-300">
          Solicitar Demo Gratis
        </button>
        <a href="#planes" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white border border-[#29A09B]/30 text-[#006C5B] font-semibold hover:border-[#29A09B] hover:shadow-md transition-all duration-300">
          Ver planes
        </a>
      </div>
    </div>

    <!-- 
      NUEVA ZONA VISUAL: CYBERNETIC PHARMACY CORE & LASER SCANNER
      -----------------------------------------------------------------
      Un núcleo digital avanzado con anillos giratorios, un haz láser 
      de escaneo dinámico en tiempo real y paneles de datos flotantes 
      ultra estilizados y modernos.
    -->
    <div class="relative h-[520px] flex items-center justify-center">

      <!-- Resplandor central dinámico -->
      <div class="absolute w-[400px] h-[400px] bg-gradient-to-tr from-[#29A09B]/30 to-[#7CC6C1]/30 blur-[90px] rounded-full pointer-events-none animate-pulse"></div>

      <!-- Contenedor del Núcleo Tecnológico -->
      <div class="relative w-full max-w-md h-[460px] bg-white/40 backdrop-blur-xl border border-white/60 rounded-3xl shadow-2xl overflow-hidden flex flex-col items-center justify-center p-6">
        
        <!-- Esquinas estilo visor cibernético -->
        <div class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-[#006C5B]"></div>
        <div class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-[#006C5B]"></div>
        <div class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-[#006C5B]"></div>
        <div class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-[#006C5B]"></div>

        <!-- Línea de escaneo láser vertical en movimiento -->
        <div class="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-[#29A09B] to-transparent shadow-[0_0_15px_#29A09B] animate-scanner z-20 pointer-events-none"></div>

        <!-- Anillos concéntricos giratorios de fondo (Radar de inventario) -->
        <div class="absolute w-64 h-64 rounded-full border border-[#29A09B]/20 animate-spin-slow pointer-events-none"></div>
        <div class="absolute w-48 h-48 rounded-full border border-dashed border-[#006C5B]/20 animate-spin-reverse pointer-events-none"></div>

        <!-- Núcleo central holográfico -->
        <div class="relative z-10 w-28 h-28 rounded-2xl bg-gradient-to-br from-[#006C5B] to-[#29A09B] shadow-xl shadow-[#006C5B]/40 border-2 border-white/50 flex flex-col items-center justify-center text-white text-center animate-float-slow">
          <svg class="w-10 h-10 text-[#7CC6C1] animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="text-[10px] font-black tracking-widest uppercase mt-1 text-[#E5F3F2]">OLLINTEM</span>
        </div>

        <!-- Tarjeta Flotante Superior: Sincronización de Lotes -->
        <div class="absolute top-8 left-6 z-30 animate-float">
          <div class="bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl shadow-lg border border-white/80 flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-xs shadow-inner">✓</div>
            <div>
              <p class="text-[9px] text-[#006C5B]/60 font-bold uppercase tracking-wider">Stock Sincronizado</p>
              <p class="text-[11px] font-extrabold text-[#006C5B]">Sucursal Centro activa</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta Flotante Derecha: Alerta de Caducidad -->
        <div class="absolute top-28 right-4 z-30 animate-float-delayed">
          <div class="bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl shadow-lg border border-white/80 flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 font-bold text-xs shadow-inner">!</div>
            <div>
              <p class="text-[9px] text-[#006C5B]/60 font-bold uppercase tracking-wider">Control de Lotes</p>
              <p class="text-[11px] font-extrabold text-[#006C5B]">Alerta de caducidad</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta Flotante Inferior Izquierda: Búsqueda Activa -->
        <div class="absolute bottom-10 left-6 z-30 animate-float">
          <div class="bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl shadow-lg border border-white/80 flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-[#29A09B]/15 flex items-center justify-center text-[#29A09B] font-bold text-xs">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <div>
              <p class="text-[9px] text-[#006C5B]/60 font-bold uppercase tracking-wider">Búsqueda Rápida</p>
              <p class="text-[11px] font-extrabold text-[#006C5B]">Por sustancia activa</p>
            </div>
          </div>
        </div>

        <!-- Pastilla decorativa flotante inferior derecha -->
        <div class="absolute bottom-12 right-6 z-30 animate-float-slow">
          <div class="px-3 py-1.5 bg-gradient-to-r from-[#29A09B] to-[#7CC6C1] rounded-full shadow-md text-white text-[10px] font-bold tracking-wide border border-white/40">
            💊 Paracetamol 500mg
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(1deg); }
  }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%      { transform: translateY(-15px) rotate(-2deg); }
  }

  @keyframes spinSlow {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes spinReverse {
    0%   { transform: rotate(360deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes scanner {
    0%, 100% { top: 5%; opacity: 0.2; }
    50%      { top: 95%; opacity: 1; }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  .animate-float-slow {
    animation: floatSlow 7s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 5s ease-in-out 2s infinite;
  }

  .animate-spin-slow {
    animation: spinSlow 15s linear infinite;
  }

  .animate-spin-reverse {
    animation: spinReverse 12s linear infinite;
  }

  .animate-scanner {
    animation: scanner 3.5s ease-in-out infinite;
  }

  @keyframes floatA {
    0%, 100% { transform: translateY(0px) rotate(20deg); }
    50%      { transform: translateY(-14px) rotate(28deg); }
  }
  @keyframes floatB {
    0%, 100% { transform: translateY(0px) rotate(-15deg); }
    50%      { transform: translateY(10px) rotate(-22deg); }
  }
</style>