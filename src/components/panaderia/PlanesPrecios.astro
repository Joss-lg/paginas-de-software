---
---
<section class="py-20 bg-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center space-y-12">
        <div class="space-y-4">
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900">Planes y Precios Transparentes</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">Elige el nivel de suscripción ideal para la escala y operación de tu panadería.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
            <!-- Plan Básico -->
            <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 shadow-sm flex flex-col justify-between">
                <div class="space-y-4">
                    <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Básico (Panaderías)</span>
                    <div class="text-4xl font-black text-gray-900">$599 <span class="text-base font-normal text-gray-600">MXN / mes</span>[cite: 1]</div>
                    <p class="text-sm text-gray-600">Ideal para panaderías de mostrador con operación rápida[cite: 1].</p>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li>✓ 1 caja / estación de cobro[cite: 1]</li>
                        <li>✓ Módulo POS y apertura de caja[cite: 1]</li>
                        <li>✓ Alta de categorías, productos y gastos[cite: 1]</li>
                        <li>✓ Reportes de ventas diarios y mensuales[cite: 1]</li>
                    </ul>
                </div>
                <div class="pt-8">
                    <a href="#contacto" class="block text-center bg-gray-900 hover:bg-gray-800 text-white font-bold py-3 rounded-xl transition">Elegir Plan</a>
                </div>
            </div>

            <!-- Plan Profesional -->
            <div class="bg-gray-900 text-white rounded-2xl p-8 shadow-xl flex flex-col justify-between relative">
                <div class="absolute -top-3 right-6 bg-yellow-400 text-gray-900 text-xs font-bold px-3 py-1 rounded-full uppercase">Popular</div>
                <div class="space-y-4">
                    <span class="bg-gray-800 text-yellow-400 text-xs font-bold px-3 py-1 rounded-full uppercase">Profesional</span>
                    <div class="text-4xl font-black">$999 <span class="text-base font-normal text-gray-400">MXN / mes</span>[cite: 1]</div>
                    <p class="text-sm text-gray-400">Para panaderías con mayor volumen y control de personal[cite: 1].</p>
                    <ul class="space-y-2 text-sm text-gray-300">
                        <li>✓ Hasta 3 estaciones de cobro[cite: 1]</li>
                        <li>✓ Módulo de roles y permisos activo[cite: 1]</li>
                        <li>✓ Captura avanzada de gastos y mermas[cite: 1]</li>
                        <li>✓ Reportes gerenciales completos[cite: 1]</li>
                    </ul>
                </div>
                <div class="pt-8">
                    <a href="#contacto" class="block text-center bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-bold py-3 rounded-xl transition">Elegir Plan</a>
                </div>
            </div>

            <!-- Plan Premium -->
            <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 shadow-sm flex flex-col justify-between">
                <div class="space-y-4">
                    <span class="bg-orange-100 text-orange-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Premium</span>
                    <div class="text-4xl font-black text-gray-900">$1,299 <span class="text-base font-normal text-gray-600">MXN / mes</span>[cite: 1]</div>
                    <p class="text-sm text-gray-600">Estaciones ilimitadas para cadenas o sucursales múltiples[cite: 1].</p>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li>✓ Estaciones ilimitadas[cite: 1]</li>
                        <li>✓ Multisucursal y control centralizado[cite: 1]</li>
                        <li>✓ Integración de pedidos y delivery[cite: 1]</li>
                        <li>✓ Soporte técnico prioritario 24/7[cite: 1]</li>
                    </ul>
                </div>
                <div class="pt-8">
                    <a href="#contacto" class="block text-center bg-gray-900 hover:bg-gray-800 text-white font-bold py-3 rounded-xl transition">Elegir Plan</a>
                </div>
            </div>
        </div>
    </div>
</section>