---
---
<!-- Sección con position relative para contener el fondo -->
<section class="relative py-20 px-4 sm:px-6 lg:px-8 border-b border-[#4a301e]">
    
    <!-- Capa de fondo con el gradiente y opacidad -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#5e3e27] to-[#784e30] opacity-90 z-0"></div>

    <!-- Contenedor principal con z-index alto para que el texto quede encima -->
    <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Columna Izquierda -->
        <div class="space-y-10">
            
            <div class="space-y-6">
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">
                    Descubre más funcionalidades de tu kit punto de venta.
                </h2>
                
                <ul class="space-y-5">
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Inventario en tiempo real:</strong> Conoce el stock exacto en tus anaqueles.
                        </p>
                    </li>
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Transferencias entre sucursales:</strong> Distribuya insumos y lleva control de cada movimiento.
                        </p>
                    </li>
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Reportes automáticos:</strong> Genera cierres de caja claros y reportes contables sin esfuerzo.
                        </p>
                    </li>
                </ul>
            </div>

            <!-- Target 1: Tarjeta de Módulos (Reacciona al estado data-hover) -->
            <div class="js-sync-target bg-white p-6 rounded-2xl shadow-xl border border-gray-100 space-y-4 transition-all duration-700 ease-out data-[hover=true]:-translate-y-2 data-[hover=true]:translate-x-1 data-[hover=true]:rotate-1 data-[hover=true]:shadow-2xl data-[hover=true]:border-[#c48b47]/60 group">
                <h3 class="text-xl font-bold text-gray-900 transition-colors duration-300 group-data-[hover=true]:text-[#c48b47]">Módulos del Sistema</h3>
                <div class="space-y-3 text-sm text-gray-800">
                    
                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-data-[hover=true]:translate-x-2 group-data-[hover=true]:border-[#c48b47]/40 group-data-[hover=true]:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-data-[hover=true]:scale-110 group-data-[hover=true]:rotate-12">🔹</span>
                        <span>Gestión de Categorías, Productos y Gastos</span>
                    </div>

                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-data-[hover=true]:translate-x-2 group-data-[hover=true]:border-[#c48b47]/40 group-data-[hover=true]:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-data-[hover=true]:scale-110 group-data-[hover=true]:rotate-12">🔹</span>
                        <span>Control estricto por Roles y Permisos</span>
                    </div>

                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-data-[hover=true]:translate-x-2 group-data-[hover=true]:border-[#c48b47]/40 group-data-[hover=true]:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-data-[hover=true]:scale-110 group-data-[hover=true]:rotate-12">🔹</span>
                        <span>Impresión de Tickets y Reportes Financieros</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Target 2: Columna Derecha (Reacciona al estado data-hover) -->
        <div class="h-full flex items-center justify-center">
            <div class="js-sync-target w-full bg-white p-2 rounded-2xl shadow-2xl border border-gray-200 flex justify-center items-center transition-all duration-700 ease-out data-[hover=true]:-translate-y-2.5 data-[hover=true]:-translate-x-1 data-[hover=true]:-rotate-1 data-[hover=true]:shadow-[0_25px_50px_-12px_rgba(196,139,71,0.5)] data-[hover=true]:border-[#c48b47] group">
                <img 
                    src="/public/modulos operativos pan.webp" 
                    alt="Vista de los Módulos Operativos" 
                    class="w-full max-h-[32rem] object-contain rounded-xl transition-transform duration-700 ease-out group-data-[hover=true]:scale-[1.03]"
                    loading="lazy"
                />
            </div>
        </div>

    </div>
</section>

<!-- Lógica para sincronizar la animación -->
<script>
    function initSyncHover() {
        // Seleccionamos ambas tarjetas mediante la clase js-sync-target
        const targets = document.querySelectorAll('.js-sync-target');
        
        targets.forEach(target => {
            // Al entrar el cursor en cualquiera de las dos, encendemos el estado en ambas
            target.addEventListener('mouseenter', () => {
                targets.forEach(t => t.setAttribute('data-hover', 'true'));
            });
            
            // Al salir el cursor, apagamos el estado en ambas
            target.addEventListener('mouseleave', () => {
                targets.forEach(t => t.removeAttribute('data-hover'));
            });
        });
    }

    // Ejecutamos en la carga inicial
    initSyncHover();
    
    // Si usas las View Transitions de Astro, esto asegura que el evento persista entre páginas
    document.addEventListener('astro:page-load', initSyncHover);
</script>