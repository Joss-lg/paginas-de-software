---
---
<!-- Sección con position relative para contener el fondo -->
<section class="relative py-20 px-4 sm:px-6 lg:px-8 border-b border-[#4a301e]">
    
    <!-- Capa de fondo con el gradiente y opacidad -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#5e3e27] to-[#784e30] opacity-90 z-0"></div>

    <!-- Contenedor principal con z-index alto para que el texto quede encima -->
    <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Columna Izquierda -->
        <div class="space-y-10">
            
            <div class="space-y-6">
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">
                    Descubre más funcionalidades de tu kit punto de venta.
                </h2>
                
                <ul class="space-y-5">
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Inventario en tiempo real:</strong> Conoce el stock exacto en tus anaqueles.
                        </p>
                    </li>
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Transferencias entre sucursales:</strong> Distribuya insumos y lleva control de cada movimiento.
                        </p>
                    </li>
                    <li class="flex items-start space-x-3">
                        <svg class="w-6 h-6 text-[#f4d4a4] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-gray-50 text-lg">
                            <strong class="text-white">Reportes automáticos:</strong> Genera cierres de caja claros y reportes contables sin esfuerzo.
                        </p>
                    </li>
                </ul>
            </div>

            <!-- Tarjeta de Módulos (Movimiento dinámico hacia arriba y ligeramente a la derecha con rotación positiva) -->
            <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 space-y-4 transition-all duration-700 ease-out hover:-translate-y-2 hover:translate-x-1 hover:rotate-1 hover:shadow-2xl hover:border-[#c48b47]/60 group">
                <h3 class="text-xl font-bold text-gray-900 transition-colors duration-300 group-hover:text-[#c48b47]">Módulos del Sistema</h3>
                <div class="space-y-3 text-sm text-gray-800">
                    
                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-hover:translate-x-2 group-hover:border-[#c48b47]/40 group-hover:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12">🔹</span>
                        <span>Gestión de Categorías, Productos y Gastos</span>
                    </div>

                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-hover:translate-x-2 group-hover:border-[#c48b47]/40 group-hover:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12">🔹</span>
                        <span>Control estricto por Roles y Permisos</span>
                    </div>

                    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-medium flex items-center gap-3 transition-all duration-300 ease-out group-hover:translate-x-2 group-hover:border-[#c48b47]/40 group-hover:bg-[#c48b47]/5">
                        <span class="text-[#c48b47] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12">🔹</span>
                        <span>Impresión de Tickets y Reportes Financieros</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha (Movimiento dinámico cruzado hacia arriba y ligeramente a la izquierda con rotación negativa) -->
        <div class="h-full flex items-center justify-center">
            <div class="w-full bg-white p-2 rounded-2xl shadow-2xl border border-gray-200 flex justify-center items-center transition-all duration-700 ease-out hover:-translate-y-2.5 hover:-translate-x-1 hover:-rotate-1 hover:shadow-[0_25px_50px_-12px_rgba(196,139,71,0.5)] hover:border-[#c48b47] group">
                <img 
                    src="/public/modulos operativos pan.webp" 
                    alt="Vista de los Módulos Operativos" 
                    class="w-full max-h-[32rem] object-contain rounded-xl transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                />
            </div>
        </div>

    </div>
</section>