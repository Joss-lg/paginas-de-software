---
// Reviews.astro

const reseñas = [
  {
    cliente: "Equipo de Operaciones",
    negocio: "Lucas Hot",
    comentario: "El ecosistema de Ollintem estabilizó por completo nuestra operación. Reconfiguraron nuestros nodos del punto de venta para que no perdieran conexión con el servidor principal en pleno servicio de alta demanda. Una joya de ingeniería.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Lucas+Hot&background=0F766E&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 2 meses"
  },
  {
    cliente: "Gerencia",
    negocio: "Pizzetos",
    comentario: "Pasamos de perder comandas en papel a tener un control absoluto de los ingredientes y los tiempos de entrega. La interfaz del mostrador es tan limpia y ágil que los nuevos cajeros aprenden a usarla en su primer turno sin errores.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Pizzetos&background=10B981&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 3 semanas"
  },
  {
    cliente: "Dirección General",
    negocio: "Panificadora El Trigo",
    comentario: "La gestión de inventario y el control de producción es exacta. Antes perdíamos capital por no calcular bien la merma diaria; hoy, con la plataforma en la nube, generamos reportes financieros detallados con un par de clics.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Sofia+V&background=0F172A&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 1 mes"
  }
];
---

<section id="reseñas" class="relative py-32 bg-slate-900 overflow-hidden border-t border-slate-800/50">
  
  <!-- Efectos de luz volumétrica -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-slate-800/50 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de la sección -->
    <div class="text-center mb-20">
      <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-slate-800 border border-slate-700 text-teal-400 text-sm font-bold tracking-wide uppercase shadow-sm">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        Prueba Social
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight mt-6">
        Casos de <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">Éxito Comprobado</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        No confíes solo en nuestra palabra. Descubre cómo nuestra infraestructura está transformando la operación diaria de empresas reales.
      </p>
    </div>

    <!-- Grid de Reseñas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reseñas.map((reseña) => (
        <div class="group relative flex flex-col p-8 rounded-[2rem] bg-slate-800/40 backdrop-blur-xl border border-slate-700/50 hover:border-teal-500/40 transition-all duration-500 overflow-hidden hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(20,184,166,0.15)] z-10">
          
          <!-- Resplandor interno sutil -->
          <div class="absolute inset-0 bg-gradient-to-b from-teal-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>

          <!-- Comillas Decorativas Gigantes de fondo -->
          <div class="absolute top-6 right-6 text-slate-700/30 group-hover:text-teal-900/30 transition-colors duration-500 z-0 pointer-events-none">
            <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <!-- Estrellas y Badge Superior -->
          <div class="flex justify-between items-center mb-8 relative z-10">
            <div class="flex gap-1">
              {[...Array(reseña.calificacion)].map(() => (
                <svg class="w-5 h-5 text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.5)]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            {reseña.verificado && (
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-400 bg-teal-500/10 px-2.5 py-1 rounded-full border border-teal-500/20">
                Verificado
              </span>
            )}
          </div>

          <!-- Texto de la reseña -->
          <p class="text-slate-300 text-base leading-relaxed flex-grow mb-10 relative z-10 font-medium">
            "{reseña.comentario}"
          </p>

          <!-- Divisor -->
          <div class="w-full h-px bg-gradient-to-r from-slate-700 to-transparent mb-6"></div>

          <!-- Perfil del cliente -->
          <div class="flex items-center gap-4 relative z-10">
            <div class="relative">
              <div class="absolute inset-0 bg-teal-500 rounded-full blur opacity-0 group-hover:opacity-40 transition-opacity duration-500"></div>
              <img src={reseña.imagen} alt={`Logo de ${reseña.negocio}`} class="w-14 h-14 rounded-full border-2 border-slate-600 group-hover:border-teal-400 transition-colors duration-300 object-cover relative z-10" loading="lazy" />
            </div>
            
            <div>
              <h4 class="text-white font-bold text-sm">{reseña.cliente}</h4>
              <p class="text-teal-400 text-xs font-semibold mb-0.5">{reseña.negocio}</p>
              <p class="text-[10px] text-slate-500 uppercase tracking-wider">{reseña.fecha}</p>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>