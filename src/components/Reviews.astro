---
// Reviews.astro

const reseñas = [
  {
    cliente: "Gerencia",
    negocio: "Lucas Hot",
    comentario: "El ecosistema de Ollintem estabilizó por completo nuestra operación. Reconfiguraron nuestros nodos del punto de venta para que no perdieran conexión con el servidor principal en pleno servicio. Además, optimizaron nuestro sistema web cuando el tráfico se disparó y estábamos por llegar al límite mensual. Una joya de ingeniería.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Lucas+Hot&background=0F766E&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 2 meses"
  },
  {
    cliente: "Mateo R.",
    negocio: "Pizzería Centro",
    comentario: "Pasamos de perder comandas en papel a tener un control absoluto de los ingredientes y los tiempos de entrega. La interfaz del mostrador es tan limpia que los nuevos cajeros aprenden a usarla en su primer turno. El soporte de la agencia es inmediato.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Mateo+R&background=10B981&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 3 semanas"
  },
  {
    cliente: "Sofía V.",
    negocio: "Panificadora El Trigo",
    comentario: "La gestión de inventario y el control de producción es exacta. Antes perdíamos dinero por no calcular bien la merma diaria, pero con la plataforma de Ollintem generamos reportes financieros detallados con un par de clics. Vale cada peso de la suscripción mensual.",
    calificacion: 5,
    imagen: "https://ui-avatars.com/api/?name=Sofia+V&background=0F172A&color=fff&size=128&bold=true",
    verificado: true,
    fecha: "Hace 1 mes"
  }
];
---

<section id="reseñas" class="relative py-24 bg-slate-900 overflow-hidden">
  
  <!-- Efectos de luz de fondo para dar aspecto tecnológico/premium -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full overflow-hidden pointer-events-none -z-0">
    <div class="absolute top-[-10%] left-[-10%] w-[40rem] h-[40rem] bg-teal-600/20 rounded-full blur-[120px] mix-blend-screen"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40rem] h-[40rem] bg-emerald-600/20 rounded-full blur-[120px] mix-blend-screen"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 py-1 px-3 rounded-full bg-slate-800 text-teal-400 text-sm font-semibold mb-4 border border-slate-700">
        Prueba Social
      </span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">
        Negocios reales, <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">resultados medibles</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        No confíes solo en nuestra palabra. Descubre cómo nuestras plataformas SaaS están transformando la operación de cientos de clientes.
      </p>
    </div>

    <!-- Grid de tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reseñas.map((reseña) => (
        <div class="group relative bg-slate-800/50 backdrop-blur-sm rounded-3xl p-8 border border-slate-700 shadow-2xl hover:border-teal-500/50 hover:bg-slate-800 transition-all duration-300 flex flex-col hover:-translate-y-1">
          
          <!-- Comillas decorativas de fondo -->
          <svg class="absolute top-6 right-6 w-10 h-10 text-slate-700 opacity-50 group-hover:text-teal-900/40 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>

          <!-- Etiqueta Verificado -->
          {reseña.verificado && (
            <div class="flex items-center gap-1.5 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-6">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Cliente Verificado
            </div>
          )}

          <!-- Texto de la reseña -->
          <p class="text-slate-300 text-base leading-relaxed flex-grow mb-8 relative z-10">
            "{reseña.comentario}"
          </p>

          <!-- Divisor -->
          <div class="w-full h-px bg-slate-700/50 mb-6"></div>

          <!-- Perfil del cliente y Calificación -->
          <div class="flex items-center justify-between mt-auto">
            <div class="flex items-center gap-4">
              <!-- Imagen del cliente (Cuando tengas fotos reales, solo cambia la URL en el arreglo superior) -->
              <img src={reseña.imagen} alt={`Foto de ${reseña.cliente}`} class="w-12 h-12 rounded-full border-2 border-slate-600 object-cover" loading="lazy" />
              
              <div>
                <h4 class="text-white font-bold text-sm">{reseña.cliente}</h4>
                <p class="text-xs text-slate-400">{reseña.negocio}</p>
              </div>
            </div>

            <!-- Estrellas y Fecha -->
            <div class="text-right">
              <div class="flex gap-0.5 justify-end mb-1">
                {[...Array(reseña.calificacion)].map(() => (
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="text-[10px] text-slate-500 font-medium uppercase tracking-wider">{reseña.fecha}</span>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>