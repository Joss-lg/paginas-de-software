---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 pt-16 pb-8 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grid principal de enlaces -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Columna 1: Marca y Descripción -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block text-2xl font-extrabold tracking-tight text-white mb-4">
          Ollintem
        </a>
        <p class="text-sm text-slate-400 mb-6 leading-relaxed">
          Ingeniería de software y sistemas de gestión diseñados para escalar y centralizar las operaciones de tu negocio.
        </p>
        <div class="flex items-start space-x-3 text-sm">
          <svg class="w-5 h-5 text-teal-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Valle de Chalco,<br />Estado de México</span>
        </div>
      </div>

      <!-- Columna 2: Catálogo de Sistemas -->
      <div>
        <h3 class="text-white font-semibold mb-4">Sistemas SaaS</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/pizzerias" class="hover:text-teal-400 transition-colors">Pizzerías</a></li>
          <li><a href="/restaurantes" class="hover:text-teal-400 transition-colors">Restaurantes</a></li>
          <li><a href="/panaderia" class="hover:text-teal-400 transition-colors">Panaderías</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors flex items-center gap-2">Control Escolar <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Pronto</span></a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors flex items-center gap-2">Abarroteras <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Pronto</span></a></li>
        </ul>
      </div>

      <!-- Columna 3: Servicios de la Agencia -->
      <div>
        <h3 class="text-white font-semibold mb-4">Nuestros Servicios</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-teal-400 transition-colors">Desarrollo de Software a Medida</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Marketing Digital</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Infraestructura y Redes LAN</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Consultoría Tecnológica</a></li>
        </ul>
      </div>

      <!-- Columna 4: Legal y Soporte -->
      <div>
        <h3 class="text-white font-semibold mb-4">Legal</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-teal-400 transition-colors">Términos de Servicio</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Aviso de Privacidad</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Acuerdos de Nivel de Servicio (SLA)</a></li>
          <li><a href="#contacto" class="hover:text-teal-400 transition-colors">Soporte Técnico</a></li>
        </ul>
      </div>

    </div>

    <!-- Barra inferior (Copyright y Redes) -->
    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm">
        © {currentYear} Ollintem. Todos los derechos reservados.
      </p>
      
      <!-- Iconos de Redes Sociales (Ejemplos) -->
      <div class="flex space-x-5">
        <a href="#" class="text-slate-400 hover:text-white transition-colors" aria-label="Facebook">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="#" class="text-slate-400 hover:text-white transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
    
  </div>
</footer>